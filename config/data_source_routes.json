{
  "version": "1.0",
  "description": "数据源路由与映射：周期、API选择、状态映射、模式别名（消除 akshare_provider / tq_adapter 中的硬编码分支）",
  "provider_routes": {
    "akshare": {
      "period_map": {
        "1d": "daily",
        "1w": "weekly",
        "1mon": "monthly",
        "5m": "5",
        "15m": "15",
        "30m": "30",
        "60m": "60",
        "1m": "1"
      },
      "sector_list_apis": {
        "1": "stock_board_industry_name_em",
        "2": "stock_board_concept_name_em"
      },
      "sector_stocks_apis": {
        "0": "stock_board_industry_cons_em",
        "1": "stock_board_concept_cons_em"
      },
      "sector_sources": {
        "em": {"categories": ["industry", "concept"]},
        "ths": {"categories": ["concept"]},
        "sw": {"categories": ["industry"]}
      },
      "sector_dispatch": {
        "em": {
          "industry": {"list": "stock_board_industry_name_em", "stocks": "stock_board_industry_cons_em"},
          "concept": {"list": "stock_board_concept_name_em", "stocks": "stock_board_concept_cons_em"}
        },
        "ths": {
          "concept": {"list": "stock_board_concept_name_ths", "stocks": "stock_board_concept_cons_ths"}
        },
        "sw": {
          "industry": {"list": "sw_index_first_info", "stocks": "sw_index_cons"}
        }
      },
      "sector_id_dispatch": {
        "ths_concept": "get_ths_concept_stocks",
        "em_industry": "get_em_industry_stocks",
        "em_concept": "get_em_concept_stocks",
        "sw_industry": "get_sw_industry_stocks"
      },
      "sector_category_dispatch": {
        "em_industry": "get_em_industry_list",
        "em_concept": "get_em_concept_list",
        "ths_concept": "get_ths_concept_list",
        "sw_industry": "get_sw_industry_list"
      },
      "block_type_to_list_type": {
        "0": 1,
        "1": 2
      }
    }
  },
  "mode_aliases": {
    "tq_dll": "dll",
    "tq_sdk": "sdk"
  },
  "provider_status_map": {
    "tq_dll": "tdx_tq_ready",
    "tq_sdk": "tdx_tq_ready",
    "akshare": "akshare_ready"
  }
}
