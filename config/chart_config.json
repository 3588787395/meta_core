        "zero_line": "rgba(255,255,255,0.25)",
        "positive_fill": "rgba(0,204,102,0.15)",
        "negative_fill": "rgba(255,68,68,0.15)",
        "line_color": "#4a9eff",
        "crosshair": "rgba(255,255,255,0.3)",
