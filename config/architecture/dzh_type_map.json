{
  "version": "1.0",
  "description": "DZH 数值节点类型到内部字符串类型的映射表",
  "type_map": {
    "1": "text_label",
    "2": "container_box",
    "3": "state_column",
    "4": "discard_pool",
    "5": "execution_order",
    "6": "flow_arrow",
    "200": "stock_state_pool",
    "201": "transfer_condition",
    "202": "market_source",
    "203": "stock_state_fallback"
  },
  "reverse_map": {
    "text_label": 1,
    "container_box": 2,
    "state_column": 3,
    "discard_pool": 4,
    "execution_order": 5,
    "flow_arrow": 6,
    "stock_state_pool": 200,
    "transfer_condition": 201,
    "market_source": 202,
    "stock_state_fallback": 203
  },
  "execution_node_types": [
    "market_source",
    "transfer_condition",
    "stock_state_pool",
    "discard_pool",
    "stock_state_fallback"
  ],
  "display_node_types": [
    "text_label",
    "container_box",
    "state_column",
    "execution_order",
    "flow_arrow"
  ],
  "aliases": {
    "market_source": "candidate_provider",
    "transfer_condition": "condition_filter",
    "discard_pool": "discard_sink",
    "container_box": "container_box",
    "execution_order": "exec_order_arrow"
  },
  "tdx_aliases": {
    "stock_state_pool": "tdx_state_pool",
    "candidate_provider": "tdx_candidate",
    "condition_filter": "tdx_condition",
    "transfer_condition": "tdx_condition",
    "market_source": "tdx_candidate"
  },
  "tdx_type_map": {
    "0": "decorative",
    "1": "decorative",
    "2": "decorative",
    "3": "tdx_condition",
    "7": "tdx_candidate",
    "8": "tdx_state_pool"
  },
  "tdx_to_dzh": {
    "0": 1,
    "1": 1,
    "2": 2,
    "3": 201,
    "7": 202,
    "8": 200
  },
  "flow_validation": {
    "allowed_sources": [
      "market_source",
      "stock_state_pool",
      "tdx_candidate",
      "tdx_state_pool"
    ],
    "allowed_middle": [
      "transfer_condition",
      "tdx_condition"
    ],
    "allowed_targets": [
      "stock_state_pool",
      "discard_pool",
      "tdx_state_pool"
    ]
  },
  "export_dispatch": {
    "market_source": {
      "dzh_cell_type": 202,
      "attr_strategy": "attr_int_or_attr_default_128",
      "pos_strategy": "standard",
      "clr_default": "cell_colors",
      "clr_conditional": true,
      "text_strategy": "set_cell_text",
      "export_fields": [
        "clr",
        "attrtext",
        "reload",
        "lastload"
      ]
    },
    "transfer_condition": {
      "dzh_cell_type": 201,
      "attr_strategy": "flag_encoded_201",
      "pos_strategy": "standard",
      "clr_default": "minus_one",
      "clr_conditional": true,
      "text_strategy": "set_cell_text",
      "export_fields": [
        "clr",
        "inditype",
        "crc",
        "indi",
        "sorttype",
        "indiparam"
      ]
    },
    "dzh_condition_pool": {
      "dzh_cell_type": 200,
      "attr_strategy": "flag_encoded_200",
      "pos_strategy": "standard",
      "clr_default": "cell_colors",
      "clr_conditional": true,
      "text_strategy": "set_cell_text",
      "export_fields": [
        "clr",
        "hold",
        "col",
        "width",
        "wizd",
        "deltype",
        "endtime",
        "delstocktype",
        "staattr",
        "sorttype",
        "intersection_status",
        "reload",
        "lastload",
        "attrtext",
        "histana",
        "stocknum",
        "tmpl",
        "enter",
        "exit",
        "bsound",
        "btip",
        "bsavetoblock",
        "stocks",
        "anas",
        "tradeattr"
      ],
      "sub_type_dispatch": {
        "4": {
          "override": "discard_pool"
        },
        "203": {
          "force_type": "203",
          "export_fields_add": [
            "result_type"
          ]
        }
      }
    },
    "stock_state_pool": {
      "dzh_cell_type": 200,
      "attr_strategy": "flag_encoded_200",
      "pos_strategy": "standard",
      "clr_default": "cell_colors",
      "clr_conditional": true,
      "text_strategy": "set_cell_text",
      "export_fields": [
        "clr",
        "hold",
        "col",
        "width",
        "wizd",
        "deltype",
        "endtime",
        "delstocktype",
        "staattr",
        "sorttype",
        "intersection_status",
        "reload",
        "lastload",
        "attrtext",
        "histana",
        "stocknum",
        "tmpl",
        "enter",
        "exit",
        "bsound",
        "btip",
        "bsavetoblock",
        "stocks",
        "anas",
        "tradeattr"
      ],
      "sub_type_dispatch": {
        "4": {
          "override": "discard_pool"
        },
        "203": {
          "force_type": "203",
          "export_fields_add": [
            "result_type"
          ]
        }
      }
    },
    "discard_pool": {
      "dzh_cell_type": 4,
      "attr_strategy": "simple_attr_int",
      "pos_strategy": "standard",
      "clr_default": "minus_one",
      "clr_conditional": false,
      "text_strategy": "set_cell_text",
      "export_fields": []
    },
    "text_label": {
      "dzh_cell_type": 1,
      "attr_strategy": "attr_int_or_attr_default_0",
      "pos_strategy": "rect_or_standard",
      "clr_default": "minus_one",
      "clr_conditional": false,
      "text_strategy": "set_cell_text",
      "export_fields": [
        "url"
      ]
    },
    "container": {
      "dzh_cell_type": 2,
      "attr_strategy": "attr_int_or_default_512_or_0",
      "pos_strategy": "rect_or_standard",
      "clr_default": "minus_one",
      "clr_conditional": false,
      "text_strategy": "set_cell_text",
      "export_fields": [],
      "extra_arg": 2
    },
    "container_box": {
      "dzh_cell_type": 2,
      "attr_strategy": "attr_int_or_default_512_or_0",
      "pos_strategy": "rect_or_standard",
      "clr_default": "minus_one",
      "clr_conditional": false,
      "text_strategy": "set_cell_text",
      "export_fields": [],
      "extra_arg": 2
    },
    "state_column": {
      "dzh_cell_type": 3,
      "attr_strategy": "attr_int_or_default_512_or_0",
      "pos_strategy": "rect_or_standard",
      "clr_default": "minus_one",
      "clr_conditional": false,
      "text_strategy": "set_cell_text",
      "export_fields": [],
      "extra_arg": 3
    },
    "execution_order": {
      "dzh_cell_type": 5,
      "attr_strategy": "simple_attr_int",
      "pos_strategy": "rect_or_standard",
      "clr_default": "minus_one",
      "clr_conditional": false,
      "text_strategy": "set_cell_text",
      "export_fields": [
        "line_type",
        "style"
      ]
    },
    "flow_arrow": {
      "dzh_cell_type": 6,
      "handler": null
    }
  },
  "dzh_cell_type_schema": {
    "_desc": "DZH cell 类型 schema：将 cell 类型差异隐含于表结构，通用解析器/构建器按表分派。parser/builder 字段指定处理函数名，params_fields/params_extra/param_mapping 为默认处理函数提供数据驱动规则。",
    "cell_types": {
      "1": {
        "node_type": "text_label",
        "model_class": "LabelCellModel",
        "parser": "_parse_cell_default",
        "builder": "_build_cell_default",
        "position_mode": "pos",
        "params_fields": [
          "attr",
          "clr",
          "url",
          "_orig_text",
          "_present_attrs"
        ],
        "params_extra": {
          "text": {
            "src": "label"
          },
          "attr_int": {
            "src": "attr_int"
          }
        },
        "param_mapping": {
          "id": {
            "src": "cell_id"
          },
          "attr": {
            "src": "params",
            "key": "attr",
            "transform": "safe_int",
            "default": 0
          },
          "position": {
            "src": "position"
          },
          "clr": {
            "src": "params",
            "key": "clr",
            "transform": "safe_int",
            "default": -1
          },
          "text": {
            "src": "label"
          },
          "url": {
            "src": "params",
            "key": "url"
          }
        }
      },
      "2": {
        "node_type": "container",
        "model_class": "ContainerCellModel",
        "parser": "_parse_cell_default",
        "builder": "_build_cell_default",
        "position_mode": "pos",
        "params_fields": [
          "attr",
          "clr",
          "text",
          "_orig_text",
          "_present_attrs"
        ],
        "params_extra": {
          "attr_int": {
            "src": "attr_int"
          },
          "show_overview": {
            "expr": "bool(attr_int & 512)"
          }
        },
        "param_mapping": {
          "id": {
            "src": "cell_id"
          },
          "attr": {
            "src": "params",
            "key": "attr",
            "transform": "safe_int",
            "default": 0
          },
          "position": {
            "src": "position"
          },
          "clr": {
            "src": "params",
            "key": "clr",
            "transform": "safe_int",
            "default": -1
          },
          "text": {
            "src": "label"
          }
        }
      },
      "3": {
        "node_type": "state_column",
        "model_class": "StateColumnModel",
        "parser": "_parse_cell_default",
        "builder": "_build_cell_default",
        "position_mode": "pos",
        "params_fields": [
