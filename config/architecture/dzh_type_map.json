          "text",
          "_orig_text",
          "_present_attrs"
        ],
        "params_extra": {
          "attr_int": {
            "src": "attr_int"
          },
          "show_overview": {
            "expr": "bool(attr_int & 512)"
          }
        },
        "param_mapping": {
          "id": {
            "src": "cell_id"
          },
          "attr": {
            "src": "params",
            "key": "attr",
            "transform": "safe_int",
            "default": 0
          },
          "position": {
            "src": "position"
          },
          "clr": {
            "src": "params",
            "key": "clr",
            "transform": "safe_int",
            "default": -1
          },
          "text": {
            "src": "label"
          }
        }
      },
      "4": {
        "node_type": "discard_pool",
        "model_class": "DiscardCellModel",
        "parser": "_parse_cell_default",
        "builder": "_build_cell_default",
        "position_mode": "func_pos",
        "label_mode": "orig_text",
        "params_fields": [
          "clr",
          "text",
          "_orig_text",
          "_present_attrs"
        ],
        "params_extra": {
          "name": {
            "src": "label"
          },
          "attr_int": {
            "src": "attr_int"
          }
        },
        "param_mapping": {
          "id": {
            "src": "cell_id"
          },
          "attr": {
            "src": "params",
            "key": "attr_int",
            "transform": "safe_int",
            "default": 0
          },
          "position": {
            "src": "position"
          },
          "clr": {
            "src": "params",
