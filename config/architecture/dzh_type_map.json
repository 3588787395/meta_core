            "transform": "safe_int",
            "default": 0
          },
          "position": {
            "src": "position"
          },
          "clr": {
            "src": "params",
            "key": "clr",
            "transform": "safe_int",
            "default": -1
          },
          "text": {
            "src": "label"
          }
        }
      },
      "201": {
        "node_type": "transfer_condition",
        "model_class": "ConditionCellModel",
        "parser": "_parse_cell_condition",
        "builder": "_build_cell_default",
        "position_mode": "pos",
        "param_mapping": {
          "id": {
            "src": "cell_id"
          },
          "attr": {
            "src": "params",
            "key": "attr_int",
            "transform": "safe_int",
            "default": 0
          },
          "position": {
            "src": "position"
          },
          "clr": {
            "src": "params",
            "key": "clr",
            "transform": "safe_int",
            "default": -1
          },
          "text": {
            "src": "label"
          },
          "inditype": {
            "src": "params",
            "key": "inditype",
            "default": "indi"
          },
          "crc": {
            "src": "params",
            "key": "crc"
          },
          "indi": {
            "src": "params",
            "key": "indi"
          },
          "sorttype": {
            "src": "params",
            "key": "sorttype"
          },
          "indiparam": {
            "src": "params",
            "key": "indiparam"
          }
        }
      },
      "200": {
        "node_type": "stock_state_pool",
        "aliases": [
          "dzh_condition_pool"
        ],
        "model_class": "StatePoolCellModel",
        "parser": "_parse_cell_pool",
        "builder": "_build_cell_pool",
        "position_mode": "func_pos",
