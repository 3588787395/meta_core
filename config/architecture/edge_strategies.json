          },
          {
            "metric": "max_in_degree",
            "value": 1
          },
          {
            "metric": "min_chain_depth",
            "min": 4
          },
          {
            "metric": "min_condition_node_count",
            "min": 2
          },
          {
            "metric": "has_cycle",
            "value": false
          }
        ],
        "execution_strategy": "serial",
        "cache_policy": "source_fingerprint",
        "cache_key": "source_id"
