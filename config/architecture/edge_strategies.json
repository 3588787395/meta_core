            "metric": "source_count",
            "value": 2
          },
          {
            "metric": "sink_count",
            "value": 1
          },
          {
            "metric": "has_cycle",
            "value": false
          }
        ],
        "execution_strategy": "parallel",
        "cache_policy": "branch_isolated",
