        "execution_strategy": "serial",
        "cache_policy": "source_fingerprint",
        "cache_key": "source_id"
      },
      {
        "pattern_id": "fan_out",
        "name": "扇出分流",
        "doc_source": [
          "DZH",
          "TDX"
        ],
        "desc": "单个源节点扇出到多个下游节点，各分支独立筛选后输出",
        "match_rules": [
          {
            "metric": "source_count",
            "value": 1
          },
          {
            "metric": "max_source_out_degree",
            "min": 2
          },
          {
            "metric": "has_cycle",
            "value": false
          }
        ],
        "execution_strategy": "parallel",
        "cache_policy": "branch_isolated",
        "cache_key": "branch_id"
      },
      {
        "pattern_id": "fan_in",
        "name": "扇入汇合",
        "doc_source": [
          "DZH",
          "TDX"
        ],
        "desc": "多个上游状态池汇入同一个目标状态池",
        "match_rules": [
          {
            "metric": "sink_count",
            "value": 1
          },
          {
            "metric": "max_sink_in_degree",
            "min": 2
          },
          {
            "metric": "has_cycle",
            "value": false
          }
        ],
        "execution_strategy": "serial",
        "cache_policy": "source_fingerprint",
        "cache_key": "source_id"
      },
      {
        "pattern_id": "loop_feedback",
