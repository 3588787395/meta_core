        "desc": "备选池/状态池 → 条件 → 状态池 → 条件 → 状态池 … 单链逐步过滤",
        "match_rules": [
          {
            "metric": "max_out_degree",
            "value": 1
          },
          {
            "metric": "max_in_degree",
            "value": 1
          },
          {
            "metric": "min_chain_depth",
            "min": 2
          },
          {
            "metric": "has_cycle",
            "value": false
