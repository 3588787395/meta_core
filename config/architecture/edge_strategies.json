  "flow_mode_registry": {
    "modes": {
      "move": {
        "name": "移动模式",
        "desc": "股票从源池移到目标池，离开源池",
        "attr_out": 8192,
        "attr_in": 8193,
        "is_move": true,
        "is_overwrite": false,
        "behavior": "满足条件的股票从源状态池删除并转移到目标状态池",
        "exec_steps": [
          "remove_from_source",
          "add_to_dest"
        ],
        "detail_template": "移动{count}只股票从{source}到{dest}"
      },
      "overwrite": {
        "name": "覆盖模式",
        "desc": "先清空目标池再写入新数据，目标始终是最新的",
        "attr_out": 4096,
        "attr_in": 4097,
        "is_move": false,
        "is_overwrite": true,
        "behavior": "先清空目的状态池的全部股票，再将满足条件的股票写入",
        "exec_steps": [
          "clear_dest",
          "add_to_dest"
        ],
        "detail_template": "清空目标池后写入{count}只股票到{dest}"
      },
      "copy": {
        "name": "复制模式",
        "desc": "保留源同时复制到目标，多阶段可累积",
        "attr_out": 20480,
        "attr_in": 20481,
        "is_move": false,
        "is_overwrite": false,
        "behavior": "源状态池股票不变，同时将满足条件的股票复制到目标状态池",
        "exec_steps": [
          "add_to_dest"
        ],
        "detail_template": "复制{count}只股票到{dest}(源池不变)"
      },
      "force_move": {
        "name": "强制移动",
        "desc": "强制覆盖写入，不考虑原有数据",
        "attr_out": 3,
        "attr_in": null,
        "is_move": true,
        "is_overwrite": true,
        "behavior": "强制模式，bit0+bit1同时设置",
        "exec_steps": [
          "clear_dest",
          "add_to_dest"
        ],
        "detail_template": "强制覆盖写入{count}只股票到{dest}"
      },
      "output_components": {
        "name": "输出成份股",
        "desc": "当源是板块时展开为个股输出",
        "attr_out": 16384,
        "attr_in": 16385,
        "is_move": false,
        "is_overwrite": false,
        "behavior": "如果源是板块节点，则展开其成份股后输出到目标",
        "exec_steps": [
          "expand_sectors",
          "add_to_dest"
        ],
        "detail_template": "展开{count}个板块为{expanded_count}只成份股"
      },
      "overwrite_copy": {
        "name": "覆盖复制模式",
        "desc": "先清空目标池再从源池复制，源池保留",
        "attr_out": 12288,
        "attr_in": null,
        "is_move": false,
        "is_overwrite": true,
        "behavior": "先清空目的状态池的全部股票，再将满足条件的股票从源池复制到目标（源池保留）",
        "exec_steps": [
          "clear_dest",
          "add_to_dest"
        ],
        "detail_template": "清空目标池后复制{count}只股票到{dest}(源池不变)"
      },
      "pass_through": {
        "name": "透传模式",
        "desc": "默认模式，直接将股票添加到目标池",
        "attr_out": null,
        "attr_in": null,
        "is_move": false,
        "is_overwrite": false,
        "behavior": "将满足条件的股票直接添加到目标状态池",
        "exec_steps": [
          "add_to_dest"
        ],
        "detail_template": "透传{count}只股票到{dest}"
      }
    },
