    "version": "2.0",
    "resolve_rules": [
      {
        "priority": 1,
        "check_bits": [
          "output_constituent"
        ],
        "mode": "output_components"
      },
      {
        "priority": 1.5,
        "check_bits": [
          "clear_dest_first",
          "keep_source"
        ],
        "mode": "overwrite_copy"
      },
      {
        "priority": 2,
        "check_bits": [
          "clear_dest_first"
        ],
        "check_bits_absent": [
          "keep_source"
        ],
        "mode": "overwrite"
      },
      {
        "priority": 3,
        "check_bits": [
          "keep_source"
        ],
        "check_bits_absent": [
          "delete_source"
        ],
        "mode": "copy"
      },
      {
        "priority": 4,
        "check_bits": [
          "delete_source",
          "force_move"
        ],
        "mode": "force_move"
      },
      {
        "priority": 5,
        "check_bits": [
          "delete_source"
        ],
        "check_bits_absent": [
          "keep_source"
        ],
        "mode": "move"
      },
      {
        "priority": 99,
        "mode": "pass_through"
      }
    ],
    "propagate_rules": {
      "copy": {
        "read_source": true,
        "clear_source": false,
        "clear_dest": false,
        "write_target": true
      },
      "move": {
        "read_source": true,
        "clear_source": true,
        "clear_dest": false,
        "write_target": true
      },
      "overwrite": {
        "read_source": true,
        "clear_source": false,
        "clear_dest": true,
        "write_target": true
      },
      "overwrite_copy": {
        "read_source": true,
        "clear_source": false,
        "clear_dest": true,
        "write_target": true
      },
      "force_move": {
        "read_source": true,
        "clear_source": true,
        "clear_dest": true,
        "write_target": true
      },
      "output_components": {
        "read_source": true,
        "clear_source": false,
        "clear_dest": false,
        "write_target": true
      },
      "pass_through": {
        "read_source": true,
        "clear_source": false,
        "clear_dest": false,
        "write_target": true
      }
    },
    "propagate_flag_map": {
      "0,0": "copy",
      "1,0": "move",
      "0,1": "overwrite",
      "1,1": "force_move"
    },
    "tdx_tran_to_bits": {
      "0": {
        "keep_source": true
      },
      "1": {
        "delete_source": true
      }
    },
    "bit_override_rules": {
      "delete_source": {
        "override": "is_move",
        "value": true
      },
      "clear_dest_first": {
        "override": "is_overwrite",
        "value": true
      }
    },
    "attr_resolution_chain": [
      {
        "op": "parse_attr_int",
        "input": "fa",
        "output": "fa"
      },
      {
        "op": "resolve_tran_bits",
        "input": "ep.tran",
        "table": "tdx_tran_to_bits",
        "mutex_table": "mutex_bits",
        "output": "fa"
      },
      {
        "op": "merge_bit_fields",
        "input": "ep",
        "fields": [
          "delete_source",
          "clear_dest_first",
          "keep_source",
          "force_move",
          "output_constituent"
        ],
        "mutex_table": "mutex_bits",
        "output": "fa"
      },
      {
        "op": "resolve_mode",
        "table": "resolve_rules",
        "modes_table": "modes",
        "output": "mode_name"
      },
      {
        "op": "derive_flags",
        "table": "bit_override_rules",
        "output": "flags"
      }
    ],
    "step_ops": {
      "parse_attr_int": {
        "method": "_step_parse_attr_int",
        "desc": "fa int → dict via DynamicFlowModel"
      },
      "resolve_tran_bits": {
        "method": "_step_resolve_tran_bits",
        "desc": "ep.tran → bits from tdx_tran_to_bits, apply mutex"
      },
      "merge_bit_fields": {
        "method": "_step_merge_bit_fields",
        "desc": "ep bit fields → fa, apply mutex"
      },
      "resolve_mode": {
        "method": "_step_resolve_mode",
        "desc": "fa → mode_name → mode_config"
      },
      "derive_flags": {
        "method": "_step_derive_flags",
        "desc": "mode_config → is_move/is_overwrite, apply override_rules"
      }
    },
    "mode_colors": {
      "move": "#1890ff",
      "overwrite": "#fa8c16",
      "copy": "#52c41a",
      "force_move": "#f5222d",
      "output_components": "#722ed1",
      "overwrite_copy": "#eb2f96",
      "pass_through": "#8c8c8c"
    }
  },
  "flow_mode_rules": {
    "version": "1.0",
    "description": "DZH 流转模式识别规则表，按优先级排序，首个匹配即返回。mask_check 表达式引用 FLOW_ATTR_* 常量名，由 _eval_mask_check 在调用时求值（attr 为待识别的 attr 整数）。",
    "flow_mode_rules": [
      {
        "mode": "output_components",
        "mask_check": "attr & FLOW_ATTR_OUTPUT_CONSTITUENT",
        "is_outflow": true
      },
      {
        "mode": "overwrite",
        "mask_check": "attr & FLOW_ATTR_CLEAR_DEST_FIRST",
        "is_outflow": true
      },
      {
        "mode": "keep_copy",
        "mask_check": "attr & FLOW_ATTR_KEEP_SOURCE and not (attr & FLOW_ATTR_DELETE_SOURCE)",
        "is_outflow": false
      },
      {
        "mode": "unknown_keep",
        "mask_check": "attr & FLOW_ATTR_KEEP_SOURCE",
        "is_outflow": false
      },
      {
        "mode": "force_move",
        "mask_check": "(attr & (FLOW_ATTR_DELETE_SOURCE | FLOW_ATTR_FORCE_MOVE)) == (FLOW_ATTR_DELETE_SOURCE | FLOW_ATTR_FORCE_MOVE)",
        "is_outflow": true
      },
      {
        "mode": "move",
        "mask_check": "attr & FLOW_ATTR_DELETE_SOURCE",
        "is_outflow": true
      },
      {
        "mode": "pass_through",
        "mask_check": "default",
        "is_outflow": false
      }
    ]
  },
  "topology": {
    "version": "1.0",
    "description": "TDX/DZH 股票池拓扑模式配置表（对照 TDX文档 §9.4 六种流转拓扑模式）",
    "modes": {
      "serial": {
        "label": "串行链式",
        "doc_ref": "模式A",
        "desc": "备选池→条件A→状态A→条件B→状态B→... 单链逐步过滤",
        "detect_rules": {
          "max_out": 1,
          "max_in": 1,
          "min_nodes": 2
        },
        "reference_pool": "黑马二号池"
      },
      "fan_out": {
        "label": "扇出分流",
        "doc_ref": "模式B",
        "desc": "单个备选池扇出到多个条件节点，各自筛选后输出到独立状态池",
        "detect_rules": {
          "source_count": 1,
          "max_out_gte": 2
        },
        "reference_pool": "黑马全息股池"
      },
      "fan_in": {
        "label": "扇入汇合",
        "doc_ref": "模式C",
        "desc": "多个状态池汇入同一个最终输出池",
        "detect_rules": {
          "sink_count": 1,
          "max_in_gte": 2
        },
        "reference_pool": "黑马全息股池"
      },
      "funnel": {
        "label": "多层漏斗",
        "doc_ref": "模式D",
        "desc": "串行链式+多条件逐步过滤，每层条件进一步过滤上一层输出",
        "detect_rules": {
          "max_out": 1,
          "chain_depth_gte": 4,
          "has_progressive_filter": true
        },
        "reference_pool": "黑马一号池"
      },
      "multi_source": {
        "label": "多源并行",
        "doc_ref": "模式E",
        "desc": "多个备选池(源节点)并行启动独立路径",
        "detect_rules": {
          "source_count_gte": 2
        },
        "reference_pool": "大路终结池"
      },
      "multi_indicator": {
        "label": "多指标并行",
        "doc_ref": "模式F",
        "desc": "单个备选池扇出到多个条件指标节点，各条件独立输出到状态池",
        "detect_rules": {
          "source_count": 1,
          "max_out_gte": 2,
          "target_is_condition": true
        },
        "reference_pool": "盘后.xml"
      },
      "loop_feedback": {
        "label": "循环反馈",
        "doc_ref": "DZH模式D",
        "desc": "状态池→条件→状态池形成环路，股票可在环路中循环流转(超赢7号)",
        "detect_rules": {
          "has_cycle": true
        },
        "reference_pool": "超赢7号"
      },
      "dual_source": {
        "label": "双源并行",
        "doc_ref": "DZH模式E",
        "desc": "两个备选池(源节点)并行启动独立路径后汇合到同一最终输出池(超赢1号)",
        "detect_rules": {
          "source_count": 2,
          "sink_count": 1
        },
        "reference_pool": "超赢1号"
      }
    },
    "detection_priority": [
      "loop_feedback",
      "dual_source",
      "funnel",
      "multi_source",
      "multi_indicator",
      "fan_out",
      "fan_in",
      "serial"
    ],
    "fallback_mode": "mixed",
    "tdx_doc_mapping": {
