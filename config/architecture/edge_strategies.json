{
  "version": "1.5",
  "pool_node_types": [
    "stock_state_pool"
  ],
  "output_types": [
    "stock_state_pool",
    "market_source",
    "tdx_state_pool"
  ],
  "source_node_types": [
    "market_source"
  ],
  "mutex_bits": {
    "keep_source": "delete_source",
    "delete_source": "keep_source"
  },
  "bar_data_injection": {
    "bar_fields": [
      "open",
      "high",
      "low",
      "close",
      "volume",
      "amount"
    ]
  },
  "toggle_handlers": {
    "field_toggles": [
      "nset_fields",
      "bdel_fields",
      "bsound_fields",
      "bsavetoblock_fields",
      "starttype_fields",
      "cxtype_fields"
    ],
    "active_when": 1,
    "nsoundtype": {
      "show_nsyssound_when": [
        0
      ],
      "show_soundfile_when": [
        1
      ]
    },
    "starttimetype": {
      "show_starttimehms_when": [
        1
      ]
    },
    "hhmmss_modes": [
      3,
      4,
      7
    ]
  },
  "node_init": {
    "market_source": {
      "op": "init_market_source"
    },
    "stock_state_pool": {
      "op": "init_stock_state_pool"
    },
    "tdx_candidate": {
      "op": "init_tdx_candidate"
    }
  },
  "node_init_ops": {
    "init_market_source": {
      "method": "init_market_source",
      "desc": "市场源初始化"
    },
    "init_stock_state_pool": {
      "method": "init_stock_state_pool",
      "desc": "状态池初始化"
    },
    "init_tdx_candidate": {
      "method": "init_tdx_candidate",
      "desc": "TDX 候选池初始化"
    }
  },
  "strategies": {
    "market_source:*": {
      "action": "resolve_and_pass",
      "pre_inject": {
        "from_source_params": [
          "markets",
          "sector_codes",
          "custom_stocks"
        ],
        "from_source_attrtext": true
      },
      "params": {
        "resolve_target": "sid",
        "resolve_fn": "candidate_resolve"
      },
      "desc": "市场源解析候选股并传递到下游节点"
    },
    "market_source:transfer_condition": {
      "action": "pass_through",
      "pre_inject": {
        "from_source_params": [
          "markets",
          "sector_codes",
          "custom_stocks"
        ],
        "from_source_attrtext": true
      },
      "params": {
        "pass_target": "tid"
      },
      "desc": "备选池股票直通传递到转移条件"
    },
    "market_source:stock_state_pool": {
      "action": "resolve_and_pass",
      "pre_inject": {
        "from_source_params": [
          "markets",
          "sector_codes",
          "custom_stocks"
        ],
        "from_source_attrtext": true
      },
      "params": {
        "resolve_target": "sid",
        "resolve_fn": "candidate_resolve"
      },
      "desc": "市场源解析候选股直接传入状态池"
    },
    "market_source:discard_pool": {
      "action": "pass_through",
      "pre_inject": {
        "from_source_params": [
          "markets",
          "sector_codes",
          "custom_stocks"
        ],
        "from_source_attrtext": true
      },
      "params": {
        "pass_target": "tid"
      },
      "desc": "市场源股票直通传递到丢弃池"
    },
    "transfer_condition:stock_state_pool": {
      "action": "apply_filter",
      "pre_inject": {
        "from_source_stocks_as": [
          "stock_list",
          "stocks"
        ],
        "from_source_node": true
      },
      "params": {
        "filter_target": "sid",
        "propagate_target": "tid",
        "dispatch_fn": "condition_dispatcher"
      },
      "desc": "转移条件过滤后传入股票状态池"
    },
    "stock_state_pool:transfer_condition": {
      "action": "pass_pool_stocks",
      "params": {
        "pass_target": "tid"
      },
      "desc": "股票状态池传递持仓到转移条件"
    },
    "stock_state_pool:stock_state_pool": {
      "action": "transfer_between_pools",
      "params": {
        "transfer_target": "tid",
        "highlight": true
      },
      "desc": "股票在状态池之间转移"
    },
    "stock_state_pool:discard_pool": {
      "action": "remove_from_pool",
      "pre_inject": {
        "from_source_stocks_as": [
          "stocks"
        ],
        "set_source_node": true
      },
      "params": {
        "remove_target": "sid"
      },
      "desc": "股票从状态池移入丢弃池"
    },
    "transfer_condition:discard_pool": {
      "action": "discard_rejected",
      "pre_inject": {
        "from_source_stocks_as": [
          "stocks"
        ],
        "set_source_node": true
      },
      "params": {
        "remove_target": "sid"
      },
      "desc": "不满足条件的股票移入丢弃池"
    },
    "stock_state_pool:transfer_condition:keep_source": {
      "action": "pass_pool_stocks",
      "params": {
        "pass_target": "tid",
        "keep_source": true
      },
      "desc": "股票状态池传递持仓到转移条件(保留源池股票)"
    },
    "tdx_candidate:tdx_condition": {
      "action": "tdx_condition_eval",
      "pre_inject": {
        "from_source_stocks_as": [
          "stock_list",
          "stocks"
        ],
        "from_source_node": true
      },
      "params": {
        "filter_target": "tid"
      },
      "desc": "TDX 候选池到条件节点的公式评估"
    },
    "tdx_candidate:tdx_state_pool": {
      "action": "transfer_between_pools",
      "pre_inject": {
        "from_source_stocks_as": [
          "stocks"
        ]
      },
      "params": {
        "transfer_target": "tid",
        "highlight": true
      },
      "desc": "TDX 候选池股票转移到状态池"
    },
    "tdx_condition:tdx_state_pool": {
      "action": "transfer_between_pools",
      "pre_inject": {
        "from_source_stocks_as": [
          "stocks"
        ]
      },
      "params": {
        "transfer_target": "tid",
        "highlight": true
      },
      "desc": "TDX 条件节点股票转移到状态池"
    },
    "dzh_condition_pool:*": {
      "action": "apply_dzh_filter",
      "pre_inject": {
        "from_source_stocks_as": [
          "stock_list",
          "stocks"
        ],
        "from_source_node": true,
        "from_source_params": [
          "hold_sec",
          "col_list",
          "enter_action",
          "exit_action",
          "sort_type",
          "formula_raw",
          "formula_crc",
          "formula_inditype",
          "indiparam",
          "condition_type",
          "show_overview",
          "record_history",
          "calc_profit_from_prev",
          "simple_intermediate",
          "keep_source",
          "clear_dest_first",
          "delete_source",
          "output_constituent",
          "analysis_cycle",
          "indi"
        ]
      },
      "params": {
        "hold_sec": 432000,
        "col_list": [],
        "enter_action": {},
        "exit_action": {}
      },
      "desc": "DZH 条件池走统一 filter 路径（formula_eval），策略参数: hold_sec/col_list/enter_action/exit_action"
    },
    "dzh_condition_pool:stock_state_pool": {
      "action": "apply_dzh_filter",
      "pre_inject": {
        "from_source_stocks_as": [
          "stock_list",
          "stocks"
        ],
        "from_source_node": true,
        "from_source_params": [
          "hold_sec",
          "col_list",
          "enter_action",
          "exit_action",
          "sort_type",
          "formula_raw",
          "formula_crc",
          "formula_inditype",
          "indiparam",
          "condition_type",
          "show_overview",
          "record_history",
          "calc_profit_from_prev",
          "simple_intermediate",
          "keep_source",
          "clear_dest_first",
          "delete_source",
          "output_constituent",
          "analysis_cycle",
          "indi"
        ]
      },
      "params": {
        "hold_sec": 432000,
        "col_list": [],
        "enter_action": {},
        "exit_action": {}
      },
      "desc": "DZH 条件池过滤后传入股票状态池（formula_eval 统一路径）"
    },
    "*:*": {
      "action": "default_transfer",
      "params": {},
      "desc": "通用默认转移：当无更具体的策略匹配时，执行 copy/move 转移"
    },
    "stock_state_pool:stock_state_pool:formula_eval": {
      "action": "formula_eval",
      "pre_inject": {
        "from_source_stocks_as": [
          "stocks"
        ],
        "from_source_node": true
      },
      "params": {
        "filter_target": "tid",
        "period": "1d"
      },
      "desc": "公式批量求值策略：从源节点取公式与股票，调 formula_router.eval_batch 批量求值后转移满足条件的股票"
    }
  },
  "action_ops": {
    "resolve_and_pass": {
      "method": "_action_resolve_and_pass",
      "desc": "解析候选股并传递"
    },
    "pass_through": {
      "method": "_action_pass_pool_stocks",
      "desc": "直通传递"
    },
    "pass_pool_stocks": {
      "method": "_action_pass_pool_stocks",
      "desc": "池股票传递"
    },
    "apply_filter": {
      "method": "_action_apply_filter",
      "desc": "条件过滤后传递"
    },
    "transfer_between_pools": {
      "method": "_action_transfer_between_pools",
      "desc": "池间转移"
    },
    "remove_from_pool": {
      "method": "_action_remove_from_pool",
      "desc": "从池中移除"
    },
    "discard_rejected": {
      "method": "_action_remove_from_pool",
      "desc": "丢弃不满足条件的"
    },
    "tdx_condition_eval": {
      "method": "tdx_condition_evaluator",
      "desc": "TDX 条件评估"
    },
    "apply_dzh_filter": {
      "method": "_action_dzh_condition_filter",
      "desc": "DZH 条件过滤"
    },
    "formula_eval": {
      "method": "_filter_formula_eval",
      "desc": "公式批量求值"
    },
    "default_transfer": {
      "method": "edge_default_transfer",
      "desc": "通用默认转移"
    }
  },
  "transformation_unit_strategies": {
    "tdx_condition": {
      "in_edge_action": "pass_through",
      "condition_action": "tdx_condition_eval",
      "out_edge_action": "transfer_between_pools",
      "in_filter_type": "conditional",
      "out_filter_type": "unconditional",
      "desc": "TDX条件节点变换单元：入边透传→条件公式评估→出边转移到状态池"
    },
    "transfer_condition": {
      "in_edge_action": "pass_through",
      "condition_action": "apply_filter",
      "out_edge_action": "transfer_between_pools",
      "in_filter_type": "conditional",
      "out_filter_type": "unconditional",
      "desc": "DZH转移条件变换单元：入边透传→条件过滤→出边转移到状态池"
    },
    "dzh_condition_pool": {
      "in_edge_action": "pass_through",
      "condition_action": "apply_dzh_filter",
      "out_edge_action": "transfer_between_pools",
      "in_filter_type": "conditional",
      "out_filter_type": "unconditional",
      "desc": "DZH条件池变换单元：入边透传→DZH条件过滤→出边转移到状态池"
    },
    "_fallback": {
      "desc": "未命中单元策略时，回退到 strategies 段的边级策略逐边处理",
      "use_edge_strategies": true
    }
  },
  "edge_filter_registry": {
    "unconditional": {
      "op": "identity",
      "propagate_mode": "builtin_propagate",
      "desc": "无条件边：全部源池股票通过（恒等 Filter），内置 propagate"
    },
    "conditional": {
      "op": "nset_dispatch",
      "propagate_mode": "internal",
      "desc": "条件边：nset 分派，filter 内部完成传播"
    },
    "formula_eval": {
      "op": "formula_batch",
      "propagate_mode": "manual_codes",
      "desc": "公式边：formula_router.eval_batch，手动 codes 传播"
    }
  },
  "filter_ops": {
    "identity": {
      "method": "_filter_identity",
      "desc": "恒等过滤：全部通过"
    },
    "nset_dispatch": {
      "method": "_filter_nset_dispatch",
      "desc": "nset 分派过滤"
    },
    "formula_batch": {
      "method": "_filter_formula_batch",
      "desc": "公式批量求值过滤"
    }
  },
  "transformations": {
    "unconditional": {
      "passed": {
        "op": "all_source_codes"
      },
      "target_update": {
        "op": "merge_or_replace"
      },
      "source_update": {
        "op": "remove_passed_if_move"
      }
    },
    "formula_eval": {
      "passed": {
        "op": "formula_eval_batch"
      },
      "target_update": {
        "op": "merge_or_replace"
      },
      "source_update": {
        "op": "remove_passed_if_move"
      }
    },
    "nset_dispatch": {
      "passed": {
        "op": "precomputed_by_strategy"
      },
      "target_update": {
        "op": "noop"
      },
      "source_update": {
        "op": "noop"
      }
    },
    "conditional": {
      "passed": {
        "op": "precomputed_by_strategy"
      },
      "target_update": {
        "op": "noop"
      },
      "source_update": {
        "op": "noop"
      }
    }
  },
  "post_propagate_hooks": [
    {
      "order": 1,
      "op": "record_execution",
      "desc": "记录执行次数和时间戳"
    },
    {
      "order": 2,
      "op": "handle_new_entries",
      "desc": "检测新入池+创建tracker+发射事件+回调"
    },
    {
      "order": 3,
      "op": "apply_ttl",
      "when": "ctx.get('tt') in config('tdx_psatt.auto_ttl_node_types')",
      "desc": "TTL 过期检查"
    }
  ],
  "hook_ops": {
    "record_execution": {
      "method": "_post_record_execution",
      "desc": "记录执行"
    },
    "handle_new_entries": {
      "method": "_post_handle_new_entries",
      "desc": "处理新入池"
    },
    "apply_ttl": {
      "method": "_post_apply_ttl",
      "desc": "TTL 淘汰"
    }
  },
  "stage_ops": {
    "pk_ranking": {
      "method": "_execute_stage",
      "desc": "PK排名"
    },
    "analysis_angles": {
      "method": "_execute_stage",
      "desc": "多分析角度"
    },
    "dashboard": {
      "method": "_execute_stage",
      "desc": "看盘面板"
    },
    "alerts": {
      "method": "_execute_stage",
      "desc": "监控告警"
    },
    "stage_bar_data_inject": {
      "method": "stage_bar_data_inject",
      "desc": "数据注入"
    },
    "stage_minute_aggregator_feed": {
      "method": "stage_minute_aggregator_feed",
      "desc": "minute_aggregator 喂数据"
    }
  },
  "canvas_edge_widths": {
    "pass": 1.5,
    "copy": 1.5,
    "overwrite": 2,
    "move": 2,
    "force": 3,
    "reject": 2
  },
  "canvas_strategy_colors": {
    "pass": "#FFD700",
    "copy": "#FFA500",
    "overwrite": "#FF8800",
    "move": "#FF4400",
    "force": "#FF0000"
  },
  "pipeline_phases": [
    {
      "order": 1,
      "step": "gate",
      "op": "gate",
      "desc": "Gate守门：eval_gate 查 runtime_modes 路由"
    },
    {
      "order": 2,
      "step": "src_change_detect",
      "op": "src_change_detect",
      "condition": {
        "filter_type": [
          "unconditional"
        ]
      },
      "desc": "源变更检测：仅无条件边需要"
    },
    {
      "order": 3,
      "step": "replay_guard",
      "op": "replay_guard",
      "condition": {
        "filter_type": [
          "conditional",
          "formula_eval"
        ],
        "mode_id": [
          "replay"
        ]
      },
      "desc": "Replay守门：回放模式下的 begin/end/interval"
    },
    {
      "order": 4,
      "step": "tdx_guard",
      "op": "tdx_guard",
      "condition": {
        "filter_type": [
          "conditional",
          "formula_eval"
        ]
      },
      "desc": "TDX守门：starttype 表驱动"
    },
    {
      "order": 5,
      "step": "duration_guard",
      "op": "duration_guard",
      "condition": {
        "filter_type": [
          "conditional",
          "formula_eval"
        ]
      },
      "desc": "Duration守门：cxtype 过期检查"
    },
    {
      "order": 6,
      "step": "flow_resolve",
      "op": "flow_resolve",
      "desc": "Flow属性解析：attr/tran → is_move/is_overwrite"
    },
    {
      "order": 6.1,
      "step": "nset_change_detect",
      "op": "change_detect",
      "condition": {
        "filter_type": [
          "conditional"
        ]
      },
      "desc": "nset 变更检测：计算 src/bar 变更标志 + 空源早退"
    },
    {
      "order": 6.2,
      "step": "nset_cache_lookup",
      "op": "cache_lookup",
      "condition": {
        "filter_type": [
          "conditional"
        ]
      },
      "desc": "nset 缓存查找：无变更时查 _filter_cache 复用结果"
    },
    {
      "order": 6.3,
      "step": "nset_execute",
      "op": "nset_execute",
      "condition": {
        "filter_type": [
          "conditional"
        ]
      },
      "desc": "nset 策略解析 + 执行分派（合并原 strategy_resolve + hr_dispatch）"
    },
    {
      "order": 6.4,
      "step": "nset_cache_write",
      "op": "cache_write",
      "condition": {
        "filter_type": [
          "conditional"
        ]
      },
      "desc": "nset 缓存写入：将结果写入 _filter_cache"
    },
    {
      "order": 7,
      "step": "transform",
      "op": "transform",
      "desc": "变换：读 transformations 表，按 passed/target_update/source_update 执行"
    },
    {
      "order": 8,
      "step": "post_process",
      "op": "post_process",
      "desc": "后处理链：count/ts→trackers→events→callback→TTL"
    }
  ],
  "phase_ops": {
    "gate": {
      "method": "_phase_gate",
      "desc": "Gate守门"
    },
    "src_change_detect": {
      "method": "_phase_src_change_detect",
      "desc": "源变更检测"
    },
    "replay_guard": {
      "method": "_phase_replay_guard",
      "desc": "回放守门"
    },
    "tdx_guard": {
      "method": "_phase_tdx_guard",
      "desc": "TDX守门"
    },
    "duration_guard": {
      "method": "_phase_duration_guard",
      "desc": "持续期守门"
    },
    "flow_resolve": {
      "method": "_phase_flow_resolve",
      "desc": "流转属性解析"
    },
    "transform": {
      "method": "_phase_transform",
      "desc": "变换执行"
    },
    "post_process": {
      "method": "_phase_post_process",
      "desc": "后处理"
    },
    "change_detect": {
      "method": "_phase_nset_change_detect",
      "desc": "变更检测 + 空源早退"
    },
    "cache_lookup": {
      "method": "_phase_nset_cache_lookup",
      "desc": "缓存查找 + 应用缓存结果"
    },
    "nset_execute": {
      "method": "_phase_nset_execute",
      "desc": "策略解析 + 执行分派（合并）"
    },
    "strategy_resolve": {
      "method": "_phase_nset_strategy_resolve",
      "desc": "策略解析得 handler 名（向后兼容）"
    },
    "hr_dispatch": {
      "method": "_phase_nset_hr_dispatch",
      "desc": "HR 分派执行实际变换（向后兼容）"
    },
    "cache_write": {
      "method": "_phase_nset_cache_write",
      "desc": "缓存写入"
    }
  },
  "event_domain_templates": {
    "resolvers": {
      "role_source_types": {
        "node": {
          "method": "_resolve_role_from_node",
          "desc": "从节点解析池角色"
        }
      },
      "cond_source_types": {
        "edge_condition": {
          "method": "_resolve_cond_from_edge",
          "desc": "从边条件解析转移条件"
        },
        "constant": {
          "method": "_resolve_cond_from_constant",
          "desc": "常量条件"
        }
      },
      "tracker_source_types": {
        "exit_tracker": {
          "method": "_resolve_tracker_from_exit",
          "desc": "从离池 tracker 解析详情"
        }
      }
    },
    "pool_enter": {
      "trigger_match": {
        "type": "pool_enter"
      },
      "signal_trigger": "pool_enter",
      "signal_route": "eventbus",
      "role_ref": "target_role",
      "codes_source": {
        "op": "transfer",
        "field": "transferred_codes"
      },
      "role_source": {
        "type": "node",
        "nid_field": "target_id"
      },
      "pool_id_field": "tid",
      "cond_source": {
        "type": "edge_condition",
        "fid_field": "flow_id"
      },
      "tracker_source": null,
      "mode_filter": null,
