{
  "version": "1.0",
  "description": "表元模式：定义所有配置表的结构约束与校验规则，用于运行时校验",
  "meta": {
    "skip_validate": ["table_schemas", "defaults", "api_routes", "mock_data", "system_rules", "action_rules_old", "toolbar_config", "context_menu_config", "theme_config", "column_definitions", "chart_config", "keyboard_shortcuts", "dialog_definitions"]
  },
  "schemas": {
    "table_schemas": {
      "description": "表元模式定义",
      "primary_key": "table_name",
      "required_fields": ["table_name", "version", "description", "fields"],
      "fields": {
        "table_name": {"type": "string", "description": "表名"},
        "version": {"type": "string", "description": "版本号"},
        "description": {"type": "string", "description": "表用途描述"},
        "primary_key": {"type": "string", "description": "主键字段名"},
        "required_fields": {"type": "array", "items": "string", "description": "必填字段列表"},
        "fields": {"type": "object", "description": "字段定义映射"},
        "relations": {"type": "object", "description": "外键关系"},
        "indexes": {"type": "array", "items": "object", "description": "索引定义"}
      }
    },
    "action_rules": {
      "description": "行为规则表：提取硬编码逻辑为规则条目",
      "collection_key": "rules",
      "primary_key": "rule_id",
      "required_fields": ["rule_id", "trigger", "action", "handler_ref"],
      "fields": {
        "rule_id": {"type": "string", "description": "规则唯一标识"},
        "description": {"type": "string", "description": "规则描述"},
        "trigger": {"type": "object", "description": "触发条件"},
        "guard": {"type": "object", "description": "守卫条件(可选，满足时才执行)"},
        "action": {"type": "string", "description": "执行动作标识"},
        "handler_ref": {"type": "string", "description": "handler注册表中的函数名"},
        "params_template": {"type": "object", "description": "参数模板(运行时合并context)"},
        "priority": {"type": "integer", "description": "优先级(数值越小越先执行)", "default": 100},
        "stop_on_match": {"type": "boolean", "description": "匹配后是否终止后续规则链", "default": true},
        "tags": {"type": "array", "items": "string", "description": "分类标签"}
      },
      "relations": {
        "handler_ref": {"references": "handler_registry", "on_invalid": "error"}
      },
      "indexes": [
        {"name": "idx_trigger_type", "fields": ["trigger.type", "trigger.cell_type"], "unique": false},
        {"name": "idx_priority", "fields": ["priority"], "unique": false},
        {"name": "idx_tags", "fields": ["tags"], "unique": false}
      ]
    },
    "ui_components": {
      "description": "UI组件注册表：定义所有前端组件类型的渲染规则",
      "collection_key": "components",
      "primary_key": "comp_id",
      "required_fields": ["component_type", "description"],
      "fields": {
        "comp_id": {"type": "string", "description": "组件唯一标识"},
        "comp_type": {"type": "string", "description": "组件类型(text/select/checkbox/group/flag_group/color/textarea/number/action_compound等)"},
        "renderer": {"type": "string", "description": "渲染器标识(映射到前端渲染函数)"},
        "props_schema": {"type": "object", "description": "组件属性模式(定义可配置的props)"},
        "validations": {"type": "array", "items": "object", "description": "校验规则列表"},
        "event_bindings": {"type": "object", "description": "事件绑定映射(change/focus/blur等)"},
        "style_template": {"type": "object", "description": "样式模板(CSS变量/类名映射)"},
        "default_value": {"type": "any", "description": "默认值"},
        "deprecated": {"type": "boolean", "description": "是否已废弃", "default": false}
      },
      "relations": {
        "renderer": {"references": "frontend_renderer_registry", "on_invalid": "warn"}
      },
      "indexes": [
        {"name": "idx_comp_type", "fields": ["comp_type"], "unique": false},
        {"name": "idx_renderer", "fields": ["renderer"], "unique": false}
      ]
    },
    "ui_layouts": {
      "description": "UI布局配置表：定义每种cell_type/edge的面板布局",
      "collection_key": "layouts",
      "primary_key": "layout_id",
      "required_fields": ["layout_id", "target_type", "sections"],
      "fields": {
        "layout_id": {"type": "string", "description": "布局唯一标识"},
        "name": {"type": "string", "description": "布局显示名称"},
        "target_type": {"type": "string", "description": "适用目标(cell_type编号或'flow')"},
        "target_scope": {"type": "string", "enum": ["node", "edge", "global"], "description": "作用域"},
        "sections": {"type": "array", "items": "object", "description": "面板分区列表"},
        "actions": {"type": "array", "items": "object", "description": "操作按钮定义"},
        "responsive_rules": {"type": "object", "description": "响应式规则"},
        "version": {"type": "string", "description": "布局版本"}
      },
      "relations": {
        "sections[].fields[].comp_ref": {"references": "ui_components.comp_id", "on_invalid": "error"}
      },
      "indexes": [
        {"name": "idx_target_type", "fields": ["target_type", "target_scope"], "unique": true}
      ]
    },
    "data_mappings": {
      "description": "数据源映射表：定义前端字段与后端数据模型的绑定路径",
      "primary_key": "mapping_id",
      "required_fields": ["mapping_id", "source_path", "target_binding"],
      "fields": {
        "mapping_id": {"type": "string", "description": "映射唯一标识"},
        "description": {"type": "string", "description": "映射描述"},
        "source_path": {"type": "string", "description": "数据源路径(如'params.hold')"},
        "source_type": {"type": "string", "description": "源数据类型(int/string/bool/float/json)"},
        "transform_expr": {"type": "string", "description": "转换表达式(可选，如'int(x/1000)')"},
        "reverse_transform": {"type": "string", "description": "反向转换表达式(用于双向绑定写回)"},
        "target_binding": {"type": "string", "description": "前端绑定目标(如'form.hold')"},
        "bidirectional": {"type": "boolean", "description": "是否双向绑定", "default": true},
        "cache_policy": {"type": "string", "enum": ["none", "read", "write_through"], "description": "缓存策略", "default": "none"},
        "default_value": {"type": "any", "description": "默认值"},
        "nullable": {"type": "boolean", "description": "是否允许null", "default": true}
      },
      "indexes": [
        {"name": "idx_source_path", "fields": ["source_path"], "unique": false},
        {"name": "idx_target_binding", "fields": ["target_binding"], "unique": false}
      ]
    },
    "modules": {
      "description": "模块注册表(已有，此处仅声明元模式)",
      "collection_key": "modules",
      "primary_key": "id",
      "required_fields": ["id", "name", "type", "handler"],
      "fields": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "handler": {"type": "string"},
        "layout_id": {"type": "string", "description": "关联的UI布局ID(新增)"}
      },
      "relations": {
        "layout_id": {"references": "ui_layouts.layout_id", "on_invalid": "warn"}
      }
    },
    "cell_type_registry": {
      "description": "Cell类型注册表(已有，此处仅声明元模式)",
      "collection_key": "types",
      "primary_key": "type_code",
      "required_fields": ["name", "category"],
      "fields": {
        "type_code": {"type": "integer", "description": "类型编码"},
        "render_config": {"type": "object", "description": "画布渲染配置(新增)"}
      }
    },
    "dispatch": {
      "description": "条件分发表：定义条件类型到处理网关的映射",
      "collection_key": "dispatch_rules",
      "primary_key": "condition_type",
      "required_fields": ["condition_type", "gateway"],
      "fields": {
        "condition_type": {"type": "string", "description": "条件类型标识"},
        "gateway": {"type": "string", "description": "处理网关"}
      }
    },
    "edge_strategies": {
      "description": "边策略表：定义源→目标节点类型的流转策略",
      "collection_key": "strategies",
      "primary_key": "edge_pattern",
      "required_fields": ["action", "handler"],
      "fields": {
        "edge_pattern": {"type": "string", "description": "边模式(如source_type:target_type)"},
        "action": {"type": "string", "description": "执行动作"},
        "handler": {"type": "string", "description": "处理函数"}
      }
    },
    "flow_mode_registry": {
      "description": "流转模式注册表：定义attr位标志到流转模式的映射规则",
      "collection_key": "modes",
      "primary_key": "mode_key",
      "required_fields": ["name", "desc"],
      "fields": {
        "mode_key": {"type": "string", "description": "模式标识"},
        "name": {"type": "string", "description": "模式名称"},
        "desc": {"type": "string", "description": "模式描述"}
      }
    },
    "pool_types": {
      "description": "池类型→执行器映射表",
      "collection_key": "pool_types",
      "primary_key": "pool_type",
      "required_fields": ["name", "executor"],
      "fields": {
        "pool_type": {"type": "string", "description": "池类型标识"},
        "name": {"type": "string", "description": "池类型名称"},
        "executor": {"type": "string", "description": "执行器函数"}
      }
    },
    "match_modes": {
      "description": "条件匹配模式→handler映射表",
      "collection_key": "match_modes",
      "primary_key": "mode_key",
      "required_fields": ["handler", "desc"],
      "fields": {
        "mode_key": {"type": "string", "description": "模式标识"},
        "handler": {"type": "string", "description": "处理函数"},
        "desc": {"type": "string", "description": "描述"}
      }
    },
    "analysis_types": {
      "description": "收益分析类型→handler映射表",
      "collection_key": "analysis_types",
      "primary_key": "type_key",
      "required_fields": ["handler", "title"],
      "fields": {
        "type_key": {"type": "string", "description": "类型标识"},
        "handler": {"type": "string", "description": "处理函数"},
        "title": {"type": "string", "description": "标题"}
      }
    },
    "actions": {
      "description": "action→handler映射表",
      "collection_key": "actions",
      "primary_key": "action_id",
      "required_fields": ["handler", "desc"],
      "fields": {
        "action_id": {"type": "string", "description": "动作标识"},
        "handler": {"type": "string", "description": "处理函数"},
        "desc": {"type": "string", "description": "描述"}
      }
    },
    "engines": {
      "description": "数据引擎注册表",
      "collection_key": "engines",
      "primary_key": "id",
      "required_fields": ["name", "fn"],
      "fields": {
        "id": {"type": "string", "description": "引擎标识"},
        "name": {"type": "string", "description": "引擎名称"},
        "fn": {"type": "string", "description": "执行函数"}
      }
    },
    "markets": {
      "description": "市场注册表",
      "collection_key": "markets",
      "primary_key": "id",
      "required_fields": ["name", "prefix"],
      "fields": {
        "id": {"type": "string", "description": "市场标识"},
        "name": {"type": "string", "description": "市场名称"},
        "prefix": {"type": "string", "description": "代码前缀"}
      }
    },
    "pool_roles": {
      "description": "池角色定义表：定义不同节点的角色,用于替代engine中硬编码的baimpool=1判断",
      "schema": "partial",
      "collection_key": "roles",
      "primary_key": "role_id",
      "required_fields": ["role_id", "name"],
      "fields": {
        "role_id": {"type": "string", "description": "角色标识"},
        "name": {"type": "string", "description": "角色名称"},
        "baimpool_value": {"type": "number", "description": "baimpool值映射"},
        "is_target": {"type": "boolean", "description": "是否目标池"},
        "is_sink": {"type": "boolean", "description": "是否废弃池"},
        "generate_buy_signal": {"type": "boolean", "description": "是否生成买入信号"},
        "generate_sell_on_exit": {"type": "boolean", "description": "离开时是否生成卖出信号"},
        "desc": {"type": "string", "description": "角色描述"},
        "priority": {"type": "number", "description": "优先级"}
      }
    },
    "property_ownership": {
      "description": "属性所有权表：定义每种节点类型在不同池类型下的属性所有权",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "description": {"type": "string", "description": "表用途描述"},
        "ownership": {"type": "object", "description": "平台独有/共有属性归属"},
        "type_ownership": {"type": "object", "description": "各节点类型的属性归属映射"},
        "type_mapping": {"type": "object", "description": "DZH/TDX类型双向映射"},
        "rules": {"type": "object", "description": "导入时的属性禁用规则"},
        "type_name_mapping": {"type": "object", "description": "类型名称到编号的映射"}
      }
    },
    "field_definitions": {
      "description": "字段定义表：全局字段元信息（数据类型/UI组件/校验/默认值/适用类型）",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "global_fields": {"type": "object", "description": "全局字段定义映射"},
        "type_specific_fields": {"type": "object", "description": "按节点类型分组的字段定义"},
        "flow_fields": {"type": "object", "description": "流转边字段定义"},
        "tdx_node_fields": {"type": "object", "description": "TDX节点字段定义"},
        "tdx_func_fields": {"type": "object", "description": "TDX公式子字段定义"},
        "tdx_psatt_fields": {"type": "object", "description": "TDX状态池属性子字段定义"},
        "tdx_flow_fields": {"type": "object", "description": "TDX流转字段定义"},
        "bit_fields": {"type": "object", "description": "位标志字段定义"}
      }
    },
    "fields": {
      "description": "辅助字段表：扩展字段定义与分组",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "price_field_priority": {"type": "array", "description": "价格字段优先级列表"},
        "tracker_fields": {"type": "object", "description": "追踪器字段映射"},
        "bar_data_filter_fields": {"type": "array", "description": "Bar数据过滤字段列表"}
      }
    },
    "data_source_mappings": {
      "description": "数据列映射表：列ID→字段名→数据源的映射关系",
      "schema": "partial",
      "collection_key": "mappings",
      "primary_key": "col_id",
      "required_fields": ["col_id", "display_name"],
      "fields": {
        "col_id": {"type": "number", "description": "列ID"},
        "display_name": {"type": "string", "description": "显示名称"},
        "tq_field": {"type": "string", "description": "天勤字段名"},
        "schema_field": {"type": "string", "description": "schema字段名"},
        "unit": {"type": "string", "description": "单位"},
        "format": {"type": "string", "description": "格式化字符串"},
        "sortable": {"type": "boolean", "description": "是否可排序"},
        "align": {"type": "string", "description": "对齐方式"},
        "source": {"type": "string", "description": "数据来源"},
        "provider": {"type": "string", "description": "数据提供者"},
        "computed": {"type": "boolean", "description": "是否为计算字段"},
        "formula": {"type": "string", "description": "计算公式"}
      }
    },
    "tracker_schema": {
      "description": "持仓跟踪表Schema：定义StockTracker的字段结构、计算公式与输出规则",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "description": {"type": "string", "description": "表用途描述"},
        "fields": {"type": "object", "description": "字段定义映射"},
        "init_fields": {"type": "array", "description": "初始化必填字段列表"},
        "formulas": {"type": "object", "description": "计算公式定义"},
        "output_fields": {"type": "object", "description": "输出字段分组定义"}
      }
    },
    "tracker_formulas": {
      "description": "追踪器公式表：追踪器计算的公式定义（无独立数据文件，结构基于命名推断）",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "formulas": {"type": "object", "description": "公式定义映射"},
        "description": {"type": "string", "description": "表用途描述"}
      }
    },
    "timing": {
      "description": "时间规则表：起始类型/持续类型规则与交易日历",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "number", "description": "版本号"},
        "starttype_rules": {"type": "object", "description": "开始类型规则映射"},
        "cxtype_rules": {"type": "object", "description": "持续类型规则映射"},
        "market_calendar": {"type": "object", "description": "交易日历配置"},
        "tick_interval": {"type": "number", "description": "tick间隔(秒)"},
        "offset_units": {"type": "object", "description": "偏移单位映射"},
        "cxtime_units": {"type": "object", "description": "持续时长单位映射"},
        "_dispatch_table": {"type": "object", "description": "分发表"},
        "simulator": {"type": "object", "description": "模拟器配置"}
      }
    },
    "post_tick_pipeline": {
      "description": "行情后处理管线表：定义每次tick执行后的后处理阶段",
      "schema": "partial",
      "collection_key": "pipeline",
      "primary_key": "stage",
      "required_fields": ["stage", "handler"],
      "fields": {
        "stage": {"type": "string", "description": "阶段标识"},
        "handler": {"type": "string", "description": "处理函数"},
        "enabled": {"type": "boolean", "description": "是否启用"},
        "config_table": {"type": "string", "description": "关联配置表"},
        "write_to": {"type": "string", "description": "写入目标"},
        "desc": {"type": "string", "description": "阶段描述"}
      }
    },
    "action_table": {
      "description": "行为动作映射表：行为码与具体动作的映射表",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "number", "description": "版本号"},
        "pool_enter_actions": {"type": "object", "description": "池进入动作映射"}
      }
    },
    "behavior_actions": {
      "description": "行为-动作绑定表：handler函数注册表与输入输出契约",
      "schema": "partial",
      "collection_key": "actions",
      "primary_key": "action_id",
      "required_fields": ["action_id", "module"],
      "fields": {
        "action_id": {"type": "string", "description": "动作标识"},
        "module": {"type": "string", "description": "模块路径"},
        "input_ports": {"type": "array", "description": "输入端口列表"},
        "output_ports": {"type": "array", "description": "输出端口列表"},
        "description": {"type": "string", "description": "动作描述"},
        "depends_on": {"type": "array", "description": "依赖配置表列表"},
        "category": {"type": "string", "description": "动作分类"}
      }
    },
    "event_rules": {
      "description": "事件规则表：定义ENTER/EXIT/TIMEOUT事件的触发规则与detail字段映射",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "description": {"type": "string", "description": "表用途描述"},
        "events": {"type": "object", "description": "事件规则映射"},
        "detail_mapping": {"type": "object", "description": "detail字段映射"},
        "common_fields": {"type": "object", "description": "公共字段定义"}
      }
    },
    "signal_rules": {
      "description": "信号规则表：定义BUY/SELL信号的触发条件、字段映射与生成规则",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "description": {"type": "string", "description": "表用途描述"},
        "signals": {"type": "object", "description": "信号规则映射"},
        "field_mapping": {"type": "object", "description": "字段映射"},
        "generation_rules": {"type": "object", "description": "信号生成规则"}
      }
    },
    "highlight_rules": {
      "description": "高亮规则表：运行/回放时节点与连线高亮规则",
      "schema": "partial",
      "primary_key": null,
      "required_fields": [],
      "fields": {
        "version": {"type": "string", "description": "版本号"},
        "description": {"type": "string", "description": "表用途描述"},
        "default_duration_ms": {"type": "number", "description": "默认高亮持续毫秒"},
        "rules": {"type": "object", "description": "高亮规则映射(cell/flow)"}
      }
    },
    "alert_rules": {
      "description": "告警规则表：定义触发条件、严重级别与冷却时间",
      "schema": "partial",
      "collection_key": "rules",
      "primary_key": "rule_id",
      "required_fields": ["rule_id", "name", "condition"],
