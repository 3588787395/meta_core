{
  "version": "1.1",
  "description": "工具栏按钮配置表 - 表驱动渲染顶部工具栏与移动端溢出菜单",
  "groups": [
    {
      "group_id": "file_ops",
      "name": "文件操作",
      "order": 1
    },
    {
      "group_id": "node_ops",
      "name": "节点操作",
      "order": 2
    },
    {
      "group_id": "io_ops",
      "name": "导入导出",
      "order": 3
    },
    {
      "group_id": "view_ops",
      "name": "视图操作",
      "order": 4
    },
    {
      "group_id": "exec_ops",
      "name": "执行控制",
      "order": 5
    },
    {
      "group_id": "run_controls",
      "name": "运行控制",
      "order": 6,
      "wrapper_class": "run-control-group"
    },
    {
      "group_id": "mode_switch",
      "name": "模式切换",
      "order": 7,
      "wrapper_class": "mode-switch-group"
    },
    {
      "group_id": "run_modes",
      "name": "运行模式",
      "order": 8,
      "wrapper_class": "run-mode-group"
    },
    {
      "group_id": "tools",
      "name": "工具与配置",
      "order": 9
    }
  ],
  "buttons": [
    {
      "group": "file_ops",
      "id": "btnHamburger",
      "icon": "☰",
      "label": "菜单",
      "action": "toggleOverflowMenu",
      "enabled_when": "always",
      "order": 0,
      "dropdown": false,
      "overflow": false,
      "position": "left",
      "button_class": "hamburger-btn"
    },
    {
      "group": "file_ops",
      "id": "btnNew",
      "icon": "🆕",
      "label": "新建",
      "action": "newPool",
      "enabled_when": "mode == 'edit'",
      "shortcut": "Ctrl+N",
      "order": 1,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "file_ops",
      "id": "btnLoadDemo",
      "icon": "📊",
      "label": "加载示例池",
      "action": "loadDemoPool",
      "enabled_when": "mode == 'edit'",
      "shortcut": "",
      "order": 1.5,
      "dropdown": false,
      "overflow": false
    },
    {
      "group": "file_ops",
      "id": "btnSave",
      "icon": "💾",
      "label": "保存",
      "action": "savePool",
      "enabled_when": "has_unsaved_changes && pool_loaded",
      "shortcut": "Ctrl+S",
      "order": 2,
      "dropdown": false,
      "overflow": false
    },
    {
      "group": "file_ops",
      "id": "btnUndo",
      "icon": "↩",
      "label": "撤销",
      "action": "undo",
      "enabled_when": "can_undo",
      "shortcut": "Ctrl+Z",
      "order": 3,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "file_ops",
      "id": "btnRedo",
      "icon": "↪",
      "label": "重做",
      "action": "redo",
      "enabled_when": "can_redo",
      "shortcut": "Ctrl+Y",
      "order": 4,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "node_ops",
      "id": "btnAddNode",
      "icon": "➕",
      "label": "添加",
      "action": "addNode",
      "enabled_when": "mode == 'edit'",
      "shortcut": "",
      "order": 1,
      "dropdown": true,
      "overflow": true,
      "dropdown_items": [
        {
          "id": "source",
          "icon": "📦",
          "label": "备选池",
          "action": "addSource",
          "data_node_type": "source",
          "mobile_float": true
        },
        {
          "id": "condition",
          "icon": "🔀",
          "label": "转移条件",
          "action": "addCondition",
          "data_node_type": "condition",
          "mobile_float": true
        },
        {
          "id": "statepool",
          "icon": "🏷",
          "label": "状态池",
          "action": "addStatePool",
          "data_node_type": "statepool",
          "mobile_float": true
        },
        {
          "id": "discard",
          "icon": "🗑",
          "label": "丢弃池",
          "action": "addDiscard",
          "data_node_type": "discard"
        },
        {
          "id": "label",
          "icon": "📝",
          "label": "文字标签",
          "action": "addLabel",
          "data_node_type": "label"
        },
        {
          "id": "container",
          "icon": "⬜",
          "label": "容器",
          "action": "addContainer",
          "data_node_type": "container"
        },
        {
          "id": "column",
          "icon": "📋",
          "label": "状态列",
          "action": "addColumn",
          "data_node_type": "column"
        }
      ]
    },
    {
      "group": "io_ops",
      "id": "btnImport",
      "icon": "📥",
      "label": "导入",
      "action": "importPool",
      "enabled_when": "mode == 'edit'",
      "shortcut": "",
      "order": 1,
      "dropdown": true,
      "overflow": true,
      "dropdown_items": [
        {
          "id": "dzh",
          "icon": "📥",
          "label": "DZH格式 XML",
          "action": "importDzh",
          "data_format": "dzh"
        },
        {
          "id": "tdx",
          "icon": "📥",
          "label": "通达信格式 XML",
          "action": "importTdx",
          "data_format": "tdx"
        },
        {
          "id": "json",
          "icon": "📥",
          "label": "JSON 格式",
          "action": "importJson",
          "data_format": "json"
        }
      ]
    },
    {
      "group": "io_ops",
      "id": "btnExport",
      "icon": "📤",
      "label": "导出",
      "action": "exportPool",
      "enabled_when": "pool_loaded",
      "shortcut": "",
      "order": 2,
      "dropdown": true,
      "overflow": true,
      "dropdown_items": [
        {
          "id": "dzh",
          "icon": "📤",
          "label": "DZH格式 XML",
          "action": "exportDzh",
          "data_format": "dzh"
        },
        {
          "id": "tdx",
          "icon": "📤",
          "label": "通达信格式 XML",
          "action": "exportTdx",
          "data_format": "tdx"
        },
        {
          "id": "json",
          "icon": "📤",
          "label": "JSON 格式",
          "action": "exportJson",
          "data_format": "json"
        }
      ]
    },
    {
      "group": "view_ops",
      "id": "btnFit",
      "icon": "⊡",
      "label": "适应",
      "action": "fitCanvas",
      "enabled_when": "pool_loaded",
      "shortcut": "",
      "order": 1,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "view_ops",
      "id": "btnTdxPools",
      "icon": "☰",
      "label": "列表",
      "action": "togglePoolList",
      "enabled_when": "always",
      "shortcut": "",
      "order": 2,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "exec_ops",
      "id": "btnExecOrder",
      "icon": "🔢",
      "label": "顺序",
      "action": "toggleExecOrder",
      "enabled_when": "pool_loaded && mode == 'edit'",
      "shortcut": "",
      "order": 1,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "exec_ops",
      "id": "btnFlowMode",
      "icon": "🔗",
      "label": "连线",
      "action": "toggleFlowMode",
      "enabled_when": "mode == 'edit'",
      "shortcut": "F",
      "order": 2,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "exec_ops",
      "id": "btnEdgeLineType",
      "icon": "📐",
      "label": "线形",
      "action": "cycleEdgeLineType",
      "enabled_when": "mode == 'edit'",
      "shortcut": "",
      "order": 3,
      "dropdown": true,
      "overflow": false,
      "dropdown_items": [
        {
          "id": "bezier",
          "icon": "〰",
          "label": "贝兹曲线",
          "action": "setEdgeLineType",
          "data_linetype": "bezier"
        },
        {
          "id": "orthogonal",
          "icon": "├",
          "label": "横竖折线",
          "action": "setEdgeLineType",
          "data_linetype": "orthogonal"
        },
        {
          "id": "straight",
          "icon": "─",
          "label": "直线",
          "action": "setEdgeLineType",
          "data_linetype": "straight"
        }
      ]
    },
    {
      "group": "run_controls",
      "id": "btnStart",
      "icon": "▶",
      "label": "开始",
      "action": "startRun",
      "enabled_when": "pool_loaded && !is_running",
      "shortcut": "",
      "order": 1,
      "dropdown": false,
      "overflow": false,
      "button_class": "run-btn"
    },
    {
      "group": "run_controls",
      "id": "btnPause",
      "icon": "⏸",
      "label": "暂停",
      "action": "pauseRun",
      "enabled_when": "is_running",
      "shortcut": "",
      "order": 2,
      "dropdown": false,
      "overflow": false,
      "button_class": "run-btn"
    },
    {
      "group": "run_controls",
      "id": "btnStop",
      "icon": "⏹",
      "label": "停止",
      "action": "stopRun",
      "enabled_when": "is_running",
      "shortcut": "",
      "order": 3,
      "dropdown": false,
      "overflow": false,
      "button_class": "run-btn"
    },
    {
      "group": "mode_switch",
      "id": "btnDesign",
      "icon": "🎨",
      "label": "设计模式",
      "action": "toggleDesignMode",
      "enabled_when": "always",
      "shortcut": "",
      "order": 1,
      "dropdown": false,
      "overflow": true,
      "button_class": "mode-btn"
    },
    {
      "group": "run_modes",
      "id": "btnRun",
      "icon": "▶",
      "label": "实盘",
      "action": "toggleRunMode",
      "enabled_when": "pool_loaded",
      "shortcut": "",
      "order": 1,
      "dropdown": false,
      "overflow": true,
      "button_class": "run-mode-btn"
    },
    {
      "group": "run_modes",
      "id": "btnReplay",
      "icon": "⏪",
      "label": "回放",
      "action": "toggleReplayMode",
      "enabled_when": "pool_loaded",
      "shortcut": "",
      "order": 2,
      "dropdown": false,
      "overflow": true,
      "button_class": "run-mode-btn"
    },
    {
      "group": "run_modes",
      "id": "btnSimulation",
      "icon": "🔬",
      "label": "仿真",
      "action": "toggleSimulationMode",
      "enabled_when": "pool_loaded",
      "shortcut": "",
      "order": 3,
      "dropdown": false,
      "overflow": true,
      "button_class": "run-mode-btn"
    },
    {
      "group": "tools",
      "id": "btnRuleEditor",
      "icon": "⚙",
      "label": "规则",
      "action": "openRuleEditor",
      "enabled_when": "always",
      "shortcut": "",
      "order": 1,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "tools",
      "id": "btnComprehensiveSettings",
      "icon": "⚙",
      "label": "综合设置",
      "action": "openComprehensiveSettings",
      "enabled_when": "pool_loaded",
      "shortcut": "",
      "order": 2,
      "dropdown": false,
      "overflow": true
    },
    {
      "group": "tools",
      "id": "btnFormula",
      "icon": "📐",
      "label": "公式",
      "action": "openFormulaEditor",
      "enabled_when": "always",
      "shortcut": "",
      "order": 3,
      "dropdown": false,
      "overflow": true,
      "is_link": true,
      "href": "formula.html"
    },
    {
      "group": "tools",
      "id": "btnConfigCenter",
      "icon": "⚙",
      "label": "配置中心",
      "action": "openConfigCenter",
      "enabled_when": "always",
      "shortcut": "",
      "order": 4,
      "dropdown": false,
      "overflow": false,
      "is_link": true,
      "href": "config.html"
    },
    {
      "group": "node_ops",
      "id": "mobileAddSource",
      "icon": "🗄",
      "label": "添加备选池",
      "action": "addSource",
      "enabled_when": "mode == 'edit'",
      "order": 100,
      "mobile": true,
      "data_node_type": "source"
    },
    {
      "group": "node_ops",
      "id": "mobileAddCondition",
      "icon": "⚙",
      "label": "添加条件",
      "action": "addCondition",
      "enabled_when": "mode == 'edit'",
      "order": 101,
      "mobile": true,
      "data_node_type": "condition"
    },
    {
      "group": "node_ops",
      "id": "mobileAddPool",
      "icon": "📦",
      "label": "添加状态池",
      "action": "addStatePool",
      "enabled_when": "mode == 'edit'",
      "order": 102,
      "mobile": true,
      "data_node_type": "statepool"
    }
  ]
}
