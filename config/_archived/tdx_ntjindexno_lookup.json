{"version": "1.0", "description": "TDX ntjindexno查找表（V9-R3最终确认）。nset=3为最新财务选股30项，nset=4为实时行情选股12项", "nset_4_market": {"description": "实时行情选股字段索引（nset=4, ntjindexno 0-11），数据来源：实时行情选股.xml全部12节点交叉验证", "fields": [{"value": 0, "label": "现价", "tq_field": "close", "unit": "元", "desc": "最新成交价"}, {"value": 1, "label": "最高", "tq_field": "high", "unit": "元", "desc": "当日最高价"}, {"value": 2, "label": "最低", "tq_field": "low", "unit": "元", "desc": "当日最低价"}, {"value": 3, "label": "今开", "tq_field": "open", "unit": "元", "desc": "当日开盘价"}, {"value": 4, "label": "昨收", "tq_field": "pre_close", "unit": "元", "desc": "前一交易日收盘价"}, {"value": 5, "label": "总量(成交量)", "tq_field": "volume", "unit": "手", "desc": "当日累计成交量（手）"}, {"value": 6, "label": "总金额(成交额)", "tq_field": "amount", "unit": "元", "desc": "当日累计成交金额（元）"}, {"value": 7, "label": "涨幅%", "tq_field": "_derived_pct_change", "unit": "%", "desc": "(现价-昨收)/昨收*100，衍生计算字段"}, {"value": 8, "label": "振幅%", "tq_field": "_derived_amplitude", "unit": "%", "desc": "(最高-最低)/昨收*100，衍生计算字段"}, {"value": 9, "label": "市盈(动态)", "tq_field": "pe", "unit": "倍", "desc": "动态市盈率"}, {"value": 10, "label": "换手率%", "tq_field": "turnover_rate", "unit": "%", "desc": "成交量/流通股本*100"}, {"value": 11, "label": "量比", "tq_field": "volume_ratio", "unit": "倍", "desc": "当前成交量/历史同期均量"}]}, "nset_3_financial": {"description": "最新财务选股字段索引（nset=3, ntjindexno 0-29）。数据来源：最新财务选股.xml(5个样本)+最新财务选股1/2.png UI截图树结构推断。用户修正: #17=净利润 #18=未分配利润", "fields": [{"value": 0, "label": "总股本", "tq_field": "zgb", "unit": "万股", "tq_api": "get_stock_info", "desc": "公司发行的全部股票数量"}, {"value": 1, "label": "流通A股", "tq_field": "ltg", "unit": "万股", "tq_api": "get_stock_info", "desc": "可在交易所自由买卖的A股数量"}, {"value": 2, "label": "B股", "tq_field": "bg", "unit": "万股", "tq_api": "get_stock_info", "desc": "境内上市外资股(B股)"}, {"value": 3, "label": "H股", "tq_field": "hg", "unit": "万股", "tq_api": "get_stock_info", "desc": "香港上市的H股"}, {"value": 4, "label": "AB股总市值", "tq_field": "total_mv", "unit": "万元", "tq_api": "get_stock_info", "desc": "A+B股合计市值"}, {"value": 5, "label": "流通市值", "tq_field": "circulating_mv", "unit": "万元", "tq_api": "get_stock_info", "desc": "可流通股票的市值"}, {"value": 6, "label": "总资产", "tq_field": "total_assets", "unit": "万元", "tq_api": "get_financial_data", "desc": "公司资产总计"}, {"value": 7, "label": "流动资产", "tq_field": "current_assets", "unit": "万元", "tq_api": "get_financial_data", "desc": "一年内可变现的资产"}, {"value": 8, "label": "无形资产", "tq_field": "intangible_assets", "unit": "万元", "tq_api": "get_financial_data", "desc": "专利/商标等无形资产价值"}, {"value": 9, "label": "流动负债", "tq_field": "current_liabilities", "unit": "万元", "tq_api": "get_financial_data", "desc": "一年内需偿还的债务"}, {"value": 10, "label": "资本公积金", "tq_field": "capital_reserve", "unit": "万元", "tq_api": "get_financial_data", "desc": "股本溢价等资本公积"}, {"value": 11, "label": "应收账款", "tq_field": "accounts_receivable", "unit": "万元", "tq_api": "get_financial_data", "desc": "应收未收款项"}, {"value": 12, "label": "营业利润", "tq_field": "operating_profit", "unit": "万元", "tq_api": "get_financial_data", "desc": "主营业务利润"}, {"value": 13, "label": "投资收益", "tq_field": "investment_income", "unit": "万元", "tq_api": "get_financial_data", "desc": "对外投资获得的收益"}, {"value": 14, "label": "经营现金流量", "tq_field": "ocf", "unit": "万元", "tq_api": "get_financial_data", "desc": "经营活动产生的现金流"}, {"value": 15, "label": "总现金流量", "tq_field": "ncf", "unit": "万元", "tq_api": "get_financial_data", "desc": "经营活动+投资+筹资现金流量净额"}, {"value": 16, "label": "存货", "tq_field": "inventory", "unit": "万元", "tq_api": "get_financial_data", "desc": "库存商品/原材料等"}, {"value": 17, "label": "净利润", "tq_field": "net_profit", "unit": "万元", "tq_api": "get_financial_data", "desc": "归属于母公司净利润（用户修正确认）"}, {"value": 18, "label": "未分配利润", "tq_field": "retained_earnings", "unit": "万元", "tq_api": "get_financial_data", "desc": "历年留存收益（用户修正确认）"}, {"value": 19, "label": "净资产(股东权益)", "tq_field": "net_assets", "unit": "万元", "tq_api": "get_stock_info/get_financial_data", "desc": "资产减负债，即股东权益"}, {"value": 20, "label": "每股净资产", "tq_field": "bps", "unit": "元/股", "tq_api": "get_stock_info", "desc": "Book Value Per Share，净资产/总股本"}, {"value": 21, "label": "每股公积金", "tq_field": "reserve_per_share", "unit": "元/股", "tq_api": "get_stock_info", "desc": "资本公积金/总股本"}, {"value": 22, "label": "每股未分配利润", "tq_field": "undistributed_per_share", "unit": "元/股", "tq_api": "get_stock_info", "desc": "未分配利润/总股本"}, {"value": 23, "label": "每股收益(EPS)", "tq_field": "eps", "unit": "元/股", "tq_api": "get_stock_info", "desc": "Earnings Per Share，净利润/总股本"}, {"value": 24, "label": "股东权益比", "tq_field": "equity_ratio", "unit": "%", "tq_api": "get_financial_data", "desc": "净资产/总资产*100"}, {"value": 25, "label": "少数股权", "tq_field": "minority_interest", "unit": "万元", "tq_api": "get_financial_data", "desc": "子公司中非控股权益"}, {"value": 26, "label": "营业收入", "tq_field": "revenue", "unit": "万元", "tq_api": "get_financial_data", "desc": "主营业务收入总额"}, {"value": 27, "label": "利润总额", "tq_field": "total_profit", "unit": "万元", "tq_api": "get_financial_data", "desc": "税前利润总额"}, {"value": 28, "label": "税后利润(净利润)", "tq_field": "net_profit_after_tax", "unit": "万元", "tq_api": "get_financial_data", "desc": "扣除所得税后的净利润（与#17可能为不同统计口径）"}, {"value": 29, "label": "净资产收益率(ROE)", "tq_field": "roe", "unit": "%", "tq_api": "get_financial_data", "desc": "Return on Equity，净利润/净资产*100"}]}}