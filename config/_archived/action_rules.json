{
  "version": "1.0",
  "description": "行为规则表：提取硬编码逻辑为规则条目，统一驱动业务逻辑与UI联动",
  "rules": [
    {
      "rule_id": "flow_mode_resolve",
      "description": "流转模式解析：根据attr位标志确定流转模式名称",
      "trigger": {"type": "edge_attr_change", "field": "attr"},
      "guard": {"context": "edge"},
      "action": "resolve_flow_mode",
      "handler_ref": "resolve_flow_mode",
      "priority": 10,
      "stop_on_match": false,
      "tags": ["flow", "mode", "resolve"]
    },
    {
      "rule_id": "begint_format_switch",
      "description": "begint字段格式切换：begin=3/4/7时使用HHMMSS格式，其余用秒数",
      "trigger": {"type": "field_change", "field": "begin"},
      "guard": null,
      "action": "switch_begint_format",
      "handler_ref": "switch_begint_format",
      "params_template": {"hhmmss_modes": [3, 4, 7]},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["flow", "schedule", "ui_linkage"]
    },
    {
      "rule_id": "tdx_nset_linkage",
      "description": "TDX nset联动：nset值变化时控制ntjindexno/accode字段显隐",
      "trigger": {"type": "field_change", "field": "func.nset"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_nset_fields",
      "handler_ref": "toggle_nset_fields",
      "params_template": {"show_ntjindexno_when": [1, 4], "show_accode_when": [0]},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "condition", "ui_linkage"]
    },
    {
      "rule_id": "tdx_psatt_bdel_linkage",
      "description": "TDX psatt.bdel联动：bdel=1时启用ndelnum/ndeltype字段",
      "trigger": {"type": "field_change", "field": "psatt.bdel"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_bdel_fields",
      "handler_ref": "toggle_bdel_fields",
      "params_template": {"active_when": 1},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "state_pool", "ui_linkage"]
    },
    {
      "rule_id": "tdx_psatt_bsound_linkage",
      "description": "TDX psatt.bsound联动：bsound=1时启用nsoundtype/soundfile字段",
      "trigger": {"type": "field_change", "field": "psatt.bsound"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_bsound_fields",
      "handler_ref": "toggle_bsound_fields",
      "params_template": {"active_when": 1},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "state_pool", "ui_linkage"]
    },
    {
      "rule_id": "tdx_psatt_bsavetoblock_linkage",
      "description": "TDX psatt.bsavetoblock联动：bsavetoblock=1时启用blockfile/bclearblock字段",
      "trigger": {"type": "field_change", "field": "psatt.bsavetoblock"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_bsavetoblock_fields",
      "handler_ref": "toggle_bsavetoblock_fields",
      "params_template": {"active_when": 1},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "state_pool", "ui_linkage"]
    },
    {
      "rule_id": "tdx_starttype_linkage",
      "description": "TDX starttype联动：starttype=0时禁用starttime/starttimehms",
      "trigger": {"type": "field_change", "field": "starttype"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_starttype_fields",
      "handler_ref": "toggle_starttype_fields",
      "params_template": {"inactive_when": 0},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "flow", "ui_linkage"]
    },
    {
      "rule_id": "tdx_cxtype_linkage",
      "description": "TDX cxtype联动：cxtype=0时禁用cxtime/cxtimetype",
      "trigger": {"type": "field_change", "field": "cxtype"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_cxtype_fields",
      "handler_ref": "toggle_cxtype_fields",
      "params_template": {"inactive_when": 0},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "flow", "ui_linkage"]
    },
    {
      "rule_id": "attr_flag_toggle",
      "description": "位标志切换：统一处理所有cell类型的attr位标志读写",
      "trigger": {"type": "flag_toggle", "field": "attr"},
      "guard": null,
      "action": "toggle_attr_flag",
      "handler_ref": "toggle_attr_flag",
      "priority": 10,
      "stop_on_match": false,
      "tags": ["attr", "flag", "universal"]
    },
    {
      "rule_id": "action_compound_encode",
      "description": "enter/exit动作编码：将动作类型+参数编码为整数",
      "trigger": {"type": "field_change", "field": "enter|exit"},
      "guard": null,
      "action": "encode_action_compound",
      "handler_ref": "encode_action_compound",
      "params_template": {"type_shift": 28, "param_mask": 65535},
      "priority": 10,
      "stop_on_match": false,
      "tags": ["action", "encode"]
    },
    {
      "rule_id": "tdx_nsoundtype_linkage",
      "description": "TDX nsoundtype联动：nsoundtype=0时显示nsyssound，nsoundtype=1时显示soundfile",
      "trigger": {"type": "field_change", "field": "psatt.nsoundtype"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_nsoundtype_fields",
      "handler_ref": "toggle_nsoundtype_fields",
      "params_template": {"show_nsyssound_when": [0], "show_soundfile_when": [1]},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "state_pool", "ui_linkage"]
    },
    {
      "rule_id": "tdx_starttimetype_linkage",
      "description": "TDX starttimetype联动：starttimetype=1时显示starttimehms",
      "trigger": {"type": "field_change", "field": "starttimetype"},
      "guard": {"pool_type": "tdx"},
      "action": "toggle_starttimetype_fields",
      "handler_ref": "toggle_starttimetype_fields",
      "params_template": {"show_starttimehms_when": [1]},
      "priority": 20,
      "stop_on_match": true,
      "tags": ["tdx", "flow", "ui_linkage"]
    }
  ],
  "handlers": [
    {"name": "init_market_source", "description": ""},
    {"name": "init_stock_state_pool", "description": ""},
    {"name": "edge_default_transfer", "description": ""},
    {"name": "stock_pool_hold", "description": ""},
    {"name": "transfer_condition_check", "description": ""},
    {"name": "discard_sink_drop", "description": ""},
    {"name": "dzh_condition_pool", "description": ""},
    {"name": "formula_eval", "description": ""},
    {"name": "cross_section_eval", "description": ""},
    {"name": "basic_filter", "description": ""},
    {"name": "condition_dispatcher", "description": ""},
    {"name": "candidate_resolve", "description": ""},
    {"name": "resolve_market", "description": ""},
    {"name": "sector_filter", "description": ""},
    {"name": "pass_through", "description": ""},
    {"name": "profit_analysis_calc", "description": ""},
    {"name": "time_trigger_check", "description": ""},
    {"name": "render_label", "description": ""},
    {"name": "render_shape", "description": ""},
    {"name": "accumulate_state", "description": ""},
    {"name": "discard_stocks", "description": ""},
    {"name": "highlight_start_handler", "description": ""},
    {"name": "highlight_stop_handler", "description": ""},
    {"name": "resolve_immediate", "description": ""},
    {"name": "resolve_delayed", "description": ""},
    {"name": "resolve_before_open", "description": ""},
    {"name": "resolve_after_open", "description": ""},
    {"name": "resolve_before_close", "description": ""},
    {"name": "resolve_after_close", "description": ""},
    {"name": "resolve_trading_time", "description": ""},
    {"name": "resolve_specific_time", "description": ""},
    {"name": "transfer_with_market_data_handler", "description": ""},
    {"name": "log_transfer_handler", "description": ""},
    {"name": "condition_dispatch_handler", "description": ""},
    {"name": "tdx_convert_from_file", "description": ""},
    {"name": "tdx_convert_from_pool", "description": ""}
  ]
}
