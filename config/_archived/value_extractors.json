{
  "extractors": {
    "ctx_key":         {"path": "ctx.{key}", "post_process": "identity"},
    "self_attr":       {"path": "self.{attr}", "post_process": "identity"},
    "edge_attr":       {"path": "edge.{attr}", "default": "", "post_process": "identity"},
    "ctx_node_nested": {"path": "ctx.{node_key}.{subkey}", "default": {}, "post_process": "identity"},
    "attr_chain":      {"path": "{path}", "fallback": "{fallback}", "post_process": "safe_timestamp"},
    "runtime_dict":    {"path": "self.{path}[{eid}]", "eid_from": "edge.id|edge.flow_id", "post_process": "safe_timestamp"},
    "arg_position":    {"path": "args[{arg_index}]", "fallback": "{fallback}", "post_process": "or_zero"},
    "dict_key":        {"path": "source.{key}", "post_process": "identity"},
    "source_attr":     {"path": "source.{attr}", "post_process": "identity"},
    "callable_fn":     {"call": "{fn}", "args": [], "post_process": "identity"},
    "literal_value":   {"value": "{value}", "post_process": "identity"},
    "method_call":     {"call": "self.{method}", "args_from_ctx": ["{args_from_ctx}"], "wrap": "{wrap}", "post_process": "identity"}
  }
}
