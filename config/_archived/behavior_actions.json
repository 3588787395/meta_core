{
  "version": "1.0",
  "description": "行为动作表——注册所有 handler 函数及其输入输出契约，供引擎动态反射调用",
  "actions": {
    "candidate_resolve": {
      "action_id": "candidate_resolve",
      "module": "native.builtins",
      "input_ports": ["markets", "sector_codes", "custom_stocks", "pool_config", "node", "node_stocks", "tq_adapter"],
      "output_ports": ["stock_list"],
      "description": "备选池解析——根据市场范围、板块代码和自定义股票生成候选股票列表",
      "depends_on": ["mock_data"],
      "category": "source"
    },
    "resolve_market": {
      "action_id": "resolve_market",
      "module": "native.builtins",
      "input_ports": ["markets", "tq_adapter", "sector_codes", "custom_stocks"],
      "output_ports": ["stock_list", "count"],
      "description": "市场解析——根据市场范围生成股票代码列表，支持板块过滤和自定义股票合并",
      "depends_on": ["mock_data"],
      "category": "source"
    },
    "stock_pool_hold": {
      "action_id": "stock_pool_hold",
      "module": "native.builtins",
      "input_ports": ["stocks", "passed", "passed_list", "stock_list", "hold_sec", "show_columns", "show_overview", "record_history", "enable_profit", "extended", "enter_action", "exit_action", "tq_adapter"],
      "output_ports": ["stocks", "hold_sec", "extended", "show_columns", "enable_profit", "record_history", "show_overview", "enter_action", "exit_action"],
      "description": "股票状态池持仓管理——处理股票进入状态池的持仓、列显示、收益计算和进出动作",
      "depends_on": [],
      "category": "accumulator"
    },
    "accumulate_state": {
      "action_id": "accumulate_state",
      "module": "native.builtins",
      "input_ports": ["result", "node", "node_stocks", "pool_config", "tq_adapter"],
      "output_ports": ["stock_list"],
      "description": "状态累积——将处理结果累积到股票状态池中",
      "depends_on": [],
      "category": "accumulator"
    },
    "dzh_condition_pool": {
      "action_id": "dzh_condition_pool",
      "module": "native.builtins",
      "input_ports": ["stock_list", "stocks", "passed_list", "passed", "hold_sec", "col_list", "show_overview", "record_history", "calc_profit_from_prev", "simple_intermediate", "keep_source", "clear_dest_first", "enter_action", "exit_action", "condition_type", "formula_raw", "formula_crc", "formula_inditype", "indiparam", "sort_type", "delete_source", "output_constituent", "_dispatch_index", "_engine_index", "tq_adapter", "indi", "analysis_cycle"],
      "output_ports": ["passed", "rejected", "hold_sec", "col_list", "show_overview", "record_history", "calc_profit_from_prev", "keep_source", "clear_dest_first", "delete_source", "output_constituent", "condition_type", "formula_crc", "formula_inditype", "inditype_is_normal", "formula_decoded", "formula_size", "indiparam", "sort_type", "sort_applied", "enter_action", "exit_action", "stocks"],
      "description": "通达信条件池——完整的条件筛选流程，支持公式评估、排序截取、持仓管理和进出动作",
      "depends_on": [],
      "category": "accumulator"
    },
    "transfer_condition_check": {
      "action_id": "transfer_condition_check",
      "module": "native.builtins",
      "input_ports": ["pool_config", "node", "node_stocks", "tq_adapter", "stock_list", "stocks"],
      "output_ports": ["passed", "stocks"],
      "description": "转移条件检查——根据节点属性标志（指标条件、基本条件、排序、反向转移、横向统计等）过滤股票",
      "depends_on": [],
      "category": "transform"
    },
    "render_label": {
      "action_id": "render_label",
      "module": "native.builtins",
      "input_ports": [],
      "output_ports": [],
      "description": "渲染文字标签——在画布上渲染文字标签节点",
      "depends_on": [],
      "category": "transform"
    },
    "render_shape": {
      "action_id": "render_shape",
      "module": "native.builtins",
      "input_ports": ["shape_type", "tq_adapter"],
      "output_ports": ["shape_type", "rendered"],
      "description": "渲染图形形状——在画布上渲染图形节点",
      "depends_on": [],
      "category": "transform"
    },
    "time_trigger_check": {
      "action_id": "time_trigger_check",
      "module": "native.builtins",
      "input_ports": ["times"],
      "output_ports": ["triggered", "current_time", "times"],
      "description": "时间触发器检查——检查当前时间是否匹配指定的触发时间列表",
      "depends_on": [],
      "category": "transform"
    },
    "profit_analysis_calc": {
      "action_id": "profit_analysis_calc",
      "module": "native.builtins",
      "input_ports": ["stocks", "passed", "passed_list", "stock_list", "analysis_type", "tq_adapter"],
      "output_ports": ["report"],
      "description": "收益分析计算——通过 analysis_types 配置表驱动分析类型路由，计算投资收益报告",
      "depends_on": ["analysis_types"],
      "category": "transform"
    },
    "discard_stocks": {
      "action_id": "discard_stocks",
      "module": "native.builtins",
      "input_ports": ["result", "node", "node_stocks", "pool_config"],
      "output_ports": [],
      "description": "丢弃股票——将不满足条件的股票移入丢弃池",
      "depends_on": [],
      "category": "sink"
    },
    "discard_sink_drop": {
      "action_id": "discard_sink_drop",
      "module": "native.builtins",
      "input_ports": ["stocks", "rejected", "rejected_list", "condition", "source_node"],
      "output_ports": ["stocks", "count", "source", "condition"],
      "description": "丢弃池收集器——收集不满足条件的股票并记录丢弃时间戳和来源信息",
      "depends_on": [],
      "category": "sink"
    },
    "condition_dispatcher": {
      "action_id": "condition_dispatcher",
      "module": "native.builtins",
      "input_ports": ["stock_list", "conditions", "_dispatch_index", "_engine_index", "tq_adapter", "node"],
      "output_ports": ["passed_list", "rejected_list"],
      "description": "条件分发器——根据条件属性位掩码匹配 dispatch_rules 配置表，路由到对应的网关处理器进行条件评估",
      "depends_on": ["dispatch_rules", "engines"],
      "category": "dispatch"
    },
    "formula_eval": {
      "action_id": "formula_eval",
      "module": "native.builtins",
      "input_ports": ["condition_type", "params", "stock_list", "stocks", "passed_list", "passed", "mode", "tq_adapter", "indi", "formula"],
      "output_ports": ["passed", "rejected", "mode"],
      "description": "公式评估网关——根据技术指标公式对股票列表进行条件评估，支持 indi/rank/reverse 模式",
      "depends_on": ["dispatch_rules"],
      "category": "dispatch"
    },
    "sector_filter": {
      "action_id": "sector_filter",
      "module": "native.builtins",
      "input_ports": ["stock_list", "stocks", "passed_list", "passed", "sector_code", "tq_adapter"],
      "output_ports": ["passed", "rejected", "sector"],
      "description": "板块过滤网关——根据板块代码过滤股票列表，只保留属于指定板块的股票",
      "depends_on": ["dispatch_rules"],
      "category": "dispatch"
    },
    "basic_filter": {
      "action_id": "basic_filter",
      "module": "native.builtins",
      "input_ports": ["stock_list", "stocks", "passed_list", "passed", "tq_adapter", "params"],
      "output_ports": ["passed", "rejected"],
      "description": "基础过滤网关——根据基本面指标（PE/PB/ROE）对股票列表进行过滤",
      "depends_on": ["dispatch_rules"],
      "category": "dispatch"
    },
    "pass_through": {
      "action_id": "pass_through",
      "module": "native.builtins",
      "input_ports": ["stock_list", "stocks", "passed_list", "passed"],
      "output_ports": ["passed", "rejected", "mode"],
      "description": "直通网关——无条件全部通过，不对股票列表做任何过滤",
      "depends_on": ["dispatch_rules"],
      "category": "dispatch"
    },
    "cross_section_eval": {
      "action_id": "cross_section_eval",
      "module": "native.builtins",
      "input_ports": ["stock_list", "stocks", "passed_list", "passed", "tq_adapter", "params", "indi"],
      "output_ports": ["passed", "rejected"],
      "description": "横向统计网关——对股票列表进行横向对比排序，按公式得分截取前N名",
      "depends_on": ["dispatch_rules"],
      "category": "dispatch"
    }
  }
}