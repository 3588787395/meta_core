{
  "version": "1.0",
  "description": "股票池拓扑模式配置表：定义 DZH 5 种 + TDX 6 种拓扑模式的识别规则与默认执行策略",
  "patterns": [
    {
      "pattern_id": "serial_chain",
      "name": "串行链式",
      "doc_source": ["DZH", "TDX"],
      "desc": "备选池/状态池 → 条件 → 状态池 → 条件 → 状态池 … 单链逐步过滤",
      "match_rules": [
        {"metric": "max_out_degree", "value": 1},
        {"metric": "max_in_degree", "value": 1},
        {"metric": "min_chain_depth", "min": 2},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "serial",
      "cache_policy": "source_fingerprint",
      "cache_key": "source_id"
    },
    {
      "pattern_id": "fan_out",
      "name": "扇出分流",
      "doc_source": ["DZH", "TDX"],
      "desc": "单个源节点扇出到多个下游节点，各分支独立筛选后输出",
      "match_rules": [
        {"metric": "source_count", "value": 1},
        {"metric": "max_source_out_degree", "min": 2},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "parallel",
      "cache_policy": "branch_isolated",
      "cache_key": "branch_id"
    },
    {
      "pattern_id": "fan_in",
      "name": "扇入汇合",
      "doc_source": ["DZH", "TDX"],
      "desc": "多个上游状态池汇入同一个目标状态池",
      "match_rules": [
        {"metric": "sink_count", "value": 1},
        {"metric": "max_sink_in_degree", "min": 2},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "serial",
      "cache_policy": "source_fingerprint",
      "cache_key": "source_id"
    },
    {
      "pattern_id": "loop_feedback",
      "name": "循环反馈",
      "doc_source": ["DZH"],
      "desc": "状态池 → 条件 → 状态池形成环路，股票可在环路中循环流转",
      "match_rules": [
        {"metric": "has_cycle", "value": true}
      ],
      "execution_strategy": "serial",
      "cache_policy": "disabled",
      "cache_key": "none"
    },
    {
      "pattern_id": "dual_source_parallel",
      "name": "双源并行",
      "doc_source": ["DZH"],
      "desc": "两个备选池并行启动独立路径后汇合到同一最终输出池",
      "match_rules": [
        {"metric": "source_count", "value": 2},
        {"metric": "sink_count", "value": 1},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "parallel",
      "cache_policy": "branch_isolated",
      "cache_key": "branch_id"
    },
    {
      "pattern_id": "multi_layer_funnel",
      "name": "多层漏斗",
      "doc_source": ["TDX"],
      "desc": "串行链式 + 多条件逐步过滤，每层条件进一步过滤上一层输出",
      "match_rules": [
        {"metric": "max_out_degree", "value": 1},
        {"metric": "max_in_degree", "value": 1},
        {"metric": "min_chain_depth", "min": 4},
        {"metric": "min_condition_node_count", "min": 2},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "serial",
      "cache_policy": "source_fingerprint",
      "cache_key": "source_id"
    },
    {
      "pattern_id": "multi_source_parallel",
      "name": "多源并行",
      "doc_source": ["TDX"],
      "desc": "多个备选池(源节点)并行启动独立路径",
      "match_rules": [
        {"metric": "min_source_count", "min": 2},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "parallel",
      "cache_policy": "branch_isolated",
      "cache_key": "branch_id"
    },
    {
      "pattern_id": "multi_indicator_parallel",
      "name": "多指标并行",
      "doc_source": ["TDX"],
      "desc": "单个备选池扇出到多个条件指标节点，各条件独立输出到状态池",
      "match_rules": [
        {"metric": "source_count", "value": 1},
        {"metric": "max_source_out_degree", "min": 2},
        {"metric": "targets_are_condition", "value": true},
        {"metric": "has_cycle", "value": false}
      ],
      "execution_strategy": "parallel",
      "cache_policy": "branch_isolated",
      "cache_key": "branch_id"
    }
  ],
  "detection_priority": [
    "loop_feedback",
    "dual_source_parallel",
    "multi_layer_funnel",
    "multi_source_parallel",
    "multi_indicator_parallel",
    "fan_out",
    "fan_in",
    "serial_chain"
  ],
  "fallback": {
    "pattern_id": "unknown",
    "execution_strategy": "serial",
    "cache_policy": "source_fingerprint",
    "cache_key": "source_id"
  }
}
