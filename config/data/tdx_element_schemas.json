{
  "version": "1.0",
  "description": "TDX XML 元素解析 schema，定义各元素的 int_fields 和字段映射",
  "elements": {
    "func": {
      "int_fields": ["nset", "ntjindexno", "nperiod", "nfirst", "noperate", "nsecond", "nbeginday", "nendday", "bnost", "bnotp", "bnotq", "nperiodnum"]
    },
    "psatt": {
      "int_fields": ["bdel", "ndelnum", "ndeltype", "baimpool", "bsound", "nsoundtype", "nsyssound", "btip", "bsavetoblock", "bclearblock", "bsavehis"]
    },
    "spinfo": {
      "int_fields": ["type", "size"],
      "sector_type_map": {
        "行业板块": 1,
        "概念板块": 2,
        "地区板块": 3,
        "板块指数": 1,
        "沪深指数": 0,
        "自定义板块": 0,
        "自动选股": 0
      }
    }
  }
}
