    "rsi_oversold": {"eval_method": "threshold", "params": {"indicator_key": "RSI1", "threshold": 30, "compare": "less"}},
    "rsi_overbought": {"eval_method": "threshold", "params": {"indicator_key": "RSI1", "threshold": 70, "compare": "greater"}},
    "rsi_down": {"eval_method": "threshold", "params": {"indicator_key": "RSI1", "threshold": 40, "compare": "less"}},
    "boll": {"eval_method": "threshold", "params": {"indicator_key": "BOLL", "threshold": 0, "compare": "greater"}}
  },
  "cross_rules": {
    "golden": {"prev_cmp": "lt", "curr_cmp": "gte"},
    "death": {"prev_cmp": "gt", "curr_cmp": "lte"}
  },
