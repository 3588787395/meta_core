{
  "version": "1.0",
  "description": "Mock 字段生成范围常量——modulus/offset/divisor/round/sign 表驱动，消除 _calc_mock_field 内联 magic numbers",
  "fields": {
    "profit_pct":       {"suffix": "",      "modulus": 1000,    "offset": -500,  "divisor": 100,    "round": 2, "sign": 1},
    "entry_price":      {"suffix": "_entry","modulus": 9000,    "offset": 1000,  "divisor": 100,    "round": 2, "sign": 1},
    "current_price":    {"suffix": "_curr", "modulus": 9500,    "offset": 950,   "divisor": 100,    "round": 2, "sign": 1},
    "cum_return_pct":   {"suffix": "",      "modulus": 5000,    "offset": -2000, "divisor": 100,    "round": 2, "sign": 1},
    "max_drawdown_pct": {"suffix": "_dd",   "modulus": 2500,    "offset": 500,   "divisor": 100,    "round": 2, "sign": -1},
    "win_rate":         {"suffix": "_wr",   "modulus": 5000,    "offset": 3000,  "divisor": 10000,  "round": 2, "sign": 1},
    "weight":           {"suffix": "_wt",   "modulus": 3000,    "offset": 0,     "divisor": 10000,  "round": 4, "sign": 1},
    "market_value":     {"suffix": "_mv",   "modulus": 990000,  "offset": 10000, "divisor": 100,    "round": 2, "sign": 1},
    "cost_basis":       {"suffix": "_cost", "modulus": 9000,    "offset": 1000,  "divisor": 100,    "round": 2, "sign": 1}
  }
}
