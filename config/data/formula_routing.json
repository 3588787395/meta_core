{
  "version": "1.1",
  "description": "公式引擎路由决策规则表，驱动通用 _resolve_engine 路由器",
  "engine_routing": [
    {
      "id": "python_simple_tick_1m",
      "condition": {
        "complexity": "simple",
        "period_in": ["1m", "tick"]
      },
      "engine": "python"
    },
    {
      "id": "hqchart_complex",
      "condition": {
        "hqchart_available": true
      },
      "engine": "hqchart"
    },
    {
      "id": "python_fallback_all",
      "condition": {
        "hqchart_available": false
      },
      "engine": "python"
    },
    {
      "id": "default",
      "condition": "default",
      "engine": "python"
    }
  ],
  "engine_methods": {
    "python": {
      "eval": "_eval_python",
      "eval_outvars": "_eval_python_outvars",
      "eval_batch": "_eval_python_batch"
    },
    "hqchart": {
      "eval": "_eval_hqchart",
      "eval_outvars": "_eval_hqchart_outvars",
      "eval_batch": "_eval_hqchart_batch"
    }
  }
}
