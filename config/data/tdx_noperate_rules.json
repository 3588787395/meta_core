{
  "version": "1.2",
  "description": "TDX noperate 操作符规则定义表，驱动通用比较器 _eval_op 与 _resolve_rank。计算逻辑由 expr/prev_expr/curr_expr/combine 字段（表达式字符串）承载，_eval_op 调 _eval_derived_expr 求值，无 if/elif 分支。mode 字段驱动 _eval_nset0_result 顶层分派（compare/rank/inflection），消除 noperate id 硬编码元组判断。",
  "records": [
    {
      "id": "0",
      "name": "等于",
      "mode": "compare",
      "description": "两序列当前值近似相等（绝对容差 1e-8，相对容差 1e-4）",
      "compare": "abs_lt",
      "params": {"tolerance_abs": 1e-8, "tolerance_rel": 1e-4},
      "expr": "abs_diff < tol"
    },
    {
      "id": "1",
      "name": "大于",
      "mode": "compare",
      "description": "line1 当前值大于 line2 当前值",
      "compare": "gt",
      "expr": "a > b"
    },
    {
      "id": "2",
      "name": "小于",
      "mode": "compare",
      "description": "line1 当前值小于 line2 当前值",
      "compare": "lt",
      "expr": "a < b"
    },
    {
      "id": "3",
      "name": "上穿",
      "mode": "compare",
      "description": "line1 前一周期低于 line2，当前周期大于等于 line2（金叉）",
      "compare": "cross",
      "direction": "above",
      "params": {"window": 2},
      "prev_expr": "line1[-2] < line2[-2]",
      "curr_expr": "line1[-1] >= line2[-1]",
      "combine": "and"
    },
    {
      "id": "4",
      "name": "下破",
      "mode": "compare",
      "description": "line1 前一周期高于 line2，当前周期小于等于 line2（死叉）",
      "compare": "cross",
      "direction": "below",
      "params": {"window": 2},
      "prev_expr": "line1[-2] > line2[-2]",
      "curr_expr": "line1[-1] <= line2[-1]",
      "combine": "and"
    },
    {
      "id": "5",
      "name": "排名为",
      "mode": "rank",
      "description": "排名操作占位：精确第N名（处理并列），由调用方统一收集后处理",
      "compare": "rank",
      "tie_handling": "exact_rank",
      "target_rank": "n"
    },
    {
      "id": "6",
      "name": "排名前N",
      "mode": "rank",
      "description": "按 line1 当前值降序取前 N 名",
      "compare": "rank",
      "order": "desc",
      "slice": "top_n",
      "params": {"default_n": 10}
    },
    {
      "id": "7",
      "name": "排名后N",
      "mode": "rank",
      "description": "按 line1 当前值升序取前 N 名（即倒数后 N 名）",
      "compare": "rank",
      "order": "asc",
      "slice": "top_n",
      "params": {"default_n": 10}
    },
    {
      "id": "8",
      "name": "上拐",
      "mode": "inflection",
      "description": "曲线由降转升：前一期的前期值 < 前一期值 <= 当前值",
      "compare": "inflection",
      "direction": "up",
      "params": {"window": 3},
      "prev_expr": "line1[-2] - line1[-3] < 0",
      "curr_expr": "line1[-1] - line1[-2] >= 0",
      "combine": "and"
    },
    {
      "id": "9",
      "name": "下拐",
      "mode": "inflection",
      "description": "曲线由升转降：前一期的前期值 > 前一期值 >= 当前值",
      "compare": "inflection",
      "direction": "down",
      "params": {"window": 3},
      "prev_expr": "line1[-2] - line1[-3] > 0",
      "curr_expr": "line1[-1] - line1[-2] <= 0",
      "combine": "and"
    }
  ],
  "rank_modes": {
    "5": {"order": "desc", "tie_handling": "exact_rank", "target_rank": "n"},
    "6": {"order": "desc", "tie_handling": "none", "slice": "top_n", "params": {"default_n": 10}},
    "7": {"order": "asc", "tie_handling": "none", "slice": "top_n", "params": {"default_n": 10}}
  }
}
