{
  "version": 1,
  "formulas": {
    "KDJ_5MIN_CROSS": {
      "name": "KDJ5分钟金叉",
      "period": "5m",
      "params": {"n": 9, "m1": 3, "m2": 3},
      "variables": {
        "rsv": "(CLOSE - LLV(LOW, n)) / (HHV(HIGH, n) - LLV(LOW, n)) * 100",
        "k": "SMA(rsv, m1, 1)",
        "d": "SMA(k, m2, 1)",
        "j": "3*k - 2*d"
      },
      "signal": "CROSS(k, d)",
      "description": "5分钟周期KDJ金叉：K线上穿D线"
    },
    "MACD_1MIN_CROSS": {
      "name": "MACD1分钟金叉",
      "period": "1m",
      "params": {"fast": 12, "slow": 26, "signal": 9},
      "variables": {
        "dif": "EMA(CLOSE, fast) - EMA(CLOSE, slow)",
        "dea": "EMA(dif, signal)",
        "macd": "2*(dif - dea)"
      },
      "signal": "CROSS(dif, dea)",
      "description": "1分钟周期MACD金叉：DIF上穿DEA"
    }
  }
}
