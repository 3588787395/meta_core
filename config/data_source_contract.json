{
  "version": 1,
  "description": "数据源契约表：声明每种数据源的可用性探测、超时、降级策略",
  "sources": {
    "local_file": {
      "name": "本地文件数据",
      "module": "meta_core.services.providers.local_file_provider",
      "class": "LocalFileProvider",
      "probe": {
        "method": "_probe",
        "args": [],
        "timeout_ms": 500,
        "description": "检测本地配置文件是否存在（通达信/大智慧/同花顺任一即可）"
      },
      "on_unavailable": "warn",
      "on_available": "use",
      "mock_fallback_allowed": false,
      "message_on_fail": "本地配置文件未找到，将降级到运行时数据源（tq_dll/akshare）"
    },
    "tq_dll": {
      "name": "通达信TQ量化",
      "module": "meta_core.services.providers.tq",
      "class": "TqDllProvider",
      "probe": {
        "method": "_probe",
        "args": [],
        "timeout_ms": 2000,
        "description": "调用 is_ready() + get_market_data() 探测"
      },
      "on_unavailable": "raise",
      "on_available": "use",
      "mock_fallback_allowed": false,
      "message_on_fail": "通达信客户端未启动或 TPythClient.dll 不可用"
    },
    "tq_sdk": {
      "name": "天勤TQ SDK",
      "module": "meta_core.services.providers.tq",
      "class": "TqSdkProvider",
      "probe": {"method": "_probe", "args": [], "timeout_ms": 3000},
      "on_unavailable": "raise",
      "mock_fallback_allowed": false
    },
    "akshare": {
      "name": "AkShare",
      "module": "meta_core.services.providers.akshare_provider",
      "class": "AkShareProvider",
      "probe": {"method": "_probe", "args": [], "timeout_ms": 5000},
      "on_unavailable": "raise",
      "mock_fallback_allowed": false
    },
    "mock": {
      "name": "模拟数据",
      "module": "meta_core.services.providers.mock_provider",
      "class": "MockProvider",
      "probe": {"method": "_probe", "args": [], "timeout_ms": 100},
      "on_unavailable": "raise",
      "mock_fallback_allowed": true,
      "explicit_only": true,
      "message_on_fail": "Mock 数据源显式选择后才能使用"
    }
  },
  "default_chain": ["tq_dll"],
  "global_policy": {
    "auto_fallback": false,
    "require_explicit_user_consent_for_mock": true,
    "log_data_source_state": true
  },
  "notes": {
    "default_chain_policy": "default_chain is explicit candidate order only, no silent fallback; mock requires explicit consent."
  },
  "injector": {
    "async_multi_tf": {
      "handler": "async_multi_tf_injector",
      "capability": "tq_adapter",
      "desc": "实盘模式异步多时间框架注入"
    },
    "sync_bar": {
      "handler": "sync_bar_injector",
      "capability": "kline_cache",
      "desc": "回放模式同步K线注入"
    },
    "mock_generate": {
      "handler": "mock_generate_injector",
      "capability": "mock_provider",
      "desc": "仿真模式 mock 数据生成注入"
    }
  },
  "multi_tf_fetcher": {
    "tq_async_fetcher": {
      "handler": "fetch_multi_tf_via_tq",
      "capability": "tq_adapter",
      "desc": "通过 TQ 异步并发获取多时间框架"
    },
    "kline_cache_fetcher": {
      "handler": "fetch_multi_tf_from_cache",
      "capability": "kline_cache",
      "desc": "从K线缓存读取多时间框架"
    },
    "mock_fetcher": {
      "handler": "fetch_multi_tf_mock",
      "capability": "mock_provider",
      "desc": "mock 多时间框架数据"
    }
  }
}
